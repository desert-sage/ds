#
# dsdb's temporal program: a `Time`, a `Date` and a `Duration` slot,
# each declared as its own type and stored as an Int (RDSC.5.5.8). Compiled by
# the branch's own Mercury dsc in the js gate, beside @ds-lang/ds's
# fixtures.

use default

schema Visit scope logical:
    id: Int key
    seen: Time mutable
    due: Date mutable
    span: Duration mutable

schema Long scope logical:
    id: Int key

rule long:
    Visit v where v.span > 1_s
->
    emit Long logical id: v.id
