#
# dsdb's `ts` program: a logical schema's `ts` is a `Time` with no
# marker, which the artefact records as the identity role ENGINE (LFAC.9.1).
# `stale` reads it; any schema may declare `ts` (LFAC.9.1). Compiled by the
# branch's own Mercury dsc in the js gate.

use default

schema Reading scope logical:
    id: Int key
    v: Int mutable
    ts: Time

rule stale:
    Reading r where now() - r.ts > 5_min
->
    log info "stale"
