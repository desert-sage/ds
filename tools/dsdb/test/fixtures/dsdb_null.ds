# dsdb's nullable program: a `Float?` and a `String?`, the shape of
# libds's own fact-body vectors (test_rfcs_fact.c). Compiled by the branch's
# own Mercury dsc in the js gate, beside @ds-lang/ds's fixtures.

use default

schema Maybe scope logical:
    id: Int key
    x: Float? mutable
    s: String? mutable
