//
// `tsc --checkJs`, strict, over lib/ (bindings/js/JS_STYLE.md JS.13,
// tools/dsdb/DSDB.md §5). The js lane runs it, with the pinned TypeScript and
// @types/node. dsdb ships no declarations, so nothing is written. @ds-lang/ds's
// types come from the declarations it ships (bindings/js/types/), as
// any TypeScript program's would.
{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noEmit": true,
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["es2022", "esnext.disposable", "dom"],
    "types": ["node"],
    "skipLibCheck": true,
    "paths": {
      "@ds-lang/ds": ["../../bindings/js/types/index.d.ts"],
      "@ds-lang/ds/browser": ["../../bindings/js/types/browser.d.ts"]
    }
  },
  "include": ["lib/**/*.js"]
}
