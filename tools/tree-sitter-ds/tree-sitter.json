{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "ds",
      "camelcase": "DS",
      "title": "DS",
      "scope": "source.ds",
      "path": ".",
      "file-types": ["ds"],
      "highlights": "queries/highlights.scm",
      "injection-regex": "^ds$"
    }
  ],
  "metadata": {
    "version": "0.0.0",
    "license": "BSD-4-Clause OR AGPL-3.0-or-later",
    "description": "The DS language, for tree-sitter",
    "authors": [{ "name": "Dan Finster and the Desert Sage Contributors" }]
  },
  "bindings": {
    "c": false,
    "go": false,
    "java": false,
    "kotlin": false,
    "node": false,
    "python": false,
    "rust": false,
    "swift": false,
    "zig": false
  }
}
