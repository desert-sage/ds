{
  "name": "DS",
  "scopeName": "source.ds",
  "fileTypes": [
    "ds"
  ],
  "comment": "GENERATED from [LLEX.9.6] and [LEXP.17.2]. Do not edit: regenerate it.",
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#string-triple"
    },
    {
      "include": "#string"
    },
    {
      "include": "#declaration-name"
    },
    {
      "include": "#regex"
    },
    {
      "include": "#dotted-builtin"
    },
    {
      "include": "#slot-read"
    },
    {
      "include": "#words-type"
    },
    {
      "include": "#words-constant"
    },
    {
      "include": "#words-declaration"
    },
    {
      "include": "#words-operator"
    },
    {
      "include": "#words-action"
    },
    {
      "include": "#words-clause"
    },
    {
      "include": "#words-builtin"
    },
    {
      "include": "#words-kwarg"
    },
    {
      "include": "#number"
    },
    {
      "include": "#operator"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comment": {
      "comment": "[LLEX.4.1]: `#` to the end of the line, outside a string.",
      "name": "comment.line.number-sign.ds",
      "match": "#.*$"
    },
    "string-triple": {
      "comment": "[LLEX.13]: TRIPLE_STR, which may span lines ([LLEX.13.1.2]).",
      "name": "string.quoted.triple.ds",
      "begin": "\"\"\"",
      "end": "\"\"\"",
      "patterns": [
        {
          "include": "#string-content"
        }
      ]
    },
    "string": {
      "comment": "[LLEX.13]: SINGLE_STR, which no raw newline may enter ([LLEX.13.1.1]): an unclosed one ends with its line.",
      "name": "string.quoted.double.ds",
      "begin": "\"",
      "end": "\"|$",
      "patterns": [
        {
          "include": "#string-content"
        }
      ]
    },
    "string-content": {
      "patterns": [
        {
          "comment": "[LGRA.2.9.1]: ESCAPE_SEQ.",
          "name": "constant.character.escape.ds",
          "match": "\\\\(?:[\"'\\\\ntr]|x[0-9A-Fa-f]{2}|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8})"
        },
        {
          "comment": "[LLEX.13.1.3]: an unknown escape is an error.",
          "name": "invalid.illegal.escape.ds",
          "match": "\\\\."
        },
        {
          "comment": "[LGRA.2.9.6.7]: `{{` and `}}` are literal braces.",
          "name": "constant.character.escape.brace.ds",
          "match": "\\{\\{|\\}\\}"
        },
        {
          "comment": "[LGRA.2.9.6.1]: an interpolation site, a path and an optional format, with no whitespace ([LGRA.2.9.6.6]).",
          "name": "meta.interpolation.ds",
          "match": "(\\{)([^\\W\\d]\\w*(?:\\.[^\\W\\d]\\w*|\\[[0-9]+\\])*)(?:(:)([^{}\"\\s]*))?(\\})",
          "captures": {
            "1": {
              "name": "punctuation.section.interpolation.begin.ds"
            },
            "2": {
              "name": "variable.other.interpolated.ds"
            },
            "3": {
              "name": "punctuation.separator.format.ds"
            },
            "4": {
              "name": "constant.other.format.ds"
            },
            "5": {
              "name": "punctuation.section.interpolation.end.ds"
            }
          }
        }
      ]
    },
    "declaration-name": {
      "comment": "A declaration and the name it declares.",
      "patterns": [
        {
          "match": "\\b(rule)\\s+([^\\W\\d]\\w*(?:\\.[^\\W\\d]\\w*)*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.ds"
            },
            "2": {
              "name": "entity.name.function.rule.ds"
            }
          }
        },
        {
          "match": "\\b(schema)\\s+([^\\W\\d]\\w*(?:\\.[^\\W\\d]\\w*)*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.ds"
            },
            "2": {
              "name": "entity.name.type.schema.ds"
            }
          }
        },
        {
          "match": "\\b(service)\\s+([^\\W\\d]\\w*(?:\\.[^\\W\\d]\\w*)*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.ds"
            },
            "2": {
              "name": "entity.name.function.service.ds"
            }
          }
        }
      ]
    },
    "regex": {
      "comment": "[LREG.6.1]: a regex literal follows `~` or `!~` only ([LREG.5.1]).",
      "match": "(!?~)\\s*(/(?:[^/\\\\\\n]|\\\\.)+/[A-Za-z]*)",
      "captures": {
        "1": {
          "name": "keyword.operator.ds"
        },
        "2": {
          "name": "string.regexp.ds"
        }
      }
    },
    "dotted-builtin": {
      "comment": "[LEXP.17.2]: a dotted builtin, whole, before its `.` reads as a slot access.",
      "name": "support.function.ds",
      "match": "\\b(?:distance\\.great_circle|distance\\.hypotenuse|distance\\.chebyshev|distance\\.euclidean|distance\\.manhattan|distance\\.cosine|calendar\\.date|calendar\\.time|math\\.degrees|math\\.radians|math\\.atan2|math\\.floor|math\\.log10|math\\.trunc|math\\.acos|math\\.asin|math\\.atan|math\\.ceil|math\\.cosh|math\\.log2|math\\.sign|math\\.sinh|math\\.sqrt|math\\.tanh|math\\.cos|math\\.exp|math\\.fma|math\\.pow|math\\.sin|math\\.tan|math\\.ln)\\b"
    },
    "slot-read": {
      "comment": "[LLEX.9.5]: the name after `.` is a slot, whatever it spells.",
      "match": "(\\.)([^\\W\\d]\\w*)",
      "captures": {
        "1": {
          "name": "punctuation.accessor.ds"
        },
        "2": {
          "name": "variable.other.property.ds"
        }
      }
    },
    "words-type": {
      "comment": "[LLEX.9.6]: the type words.",
      "name": "support.type.ds",
      "match": "\\b(?:ComputationError|TypeError|Duration|Interval|Schema|String|Bytes|Float|Bool|Date|Json|Time|Int)\\b"
    },
    "words-constant": {
      "comment": "[LLEX.9.6]: the constant words.",
      "name": "constant.language.ds",
      "match": "\\b(?:false|null|true|NaN|inf|nan)\\b"
    },
    "words-declaration": {
      "comment": "[LLEX.9.6]: the declaration words.",
      "name": "keyword.declaration.ds",
      "match": "\\b(?:service|import|opaque|schema|series|const|from|rule|test|unit|use)\\b"
    },
    "words-operator": {
      "comment": "[LLEX.9.6]: the operator words.",
      "name": "keyword.operator.word.ds",
      "match": "\\b(?:contains|overlaps|and|not|in|is|or)\\b"
    },
    "words-action": {
      "comment": "[LLEX.9.6]: the action words.",
      "name": "keyword.control.action.ds",
      "match": "\\b(?:cache_delete|withdraw|publish|cache|call|emit|log)\\b"
    },
    "words-clause": {
      "comment": "[LLEX.9.6]: the clause words.",
      "name": "keyword.other.clause.ds",
      "match": "\\b(?:cache_deleted|filter_fields|record_event|activation|max_window|activated|dimension|from_base|hydration|inverting|max_limit|published|responses|retracted|tolerance|all_time|capacity|cooldown|explicit|hydrates|implicit|produces|recorded|required|response|retained|tumbling|ambient|default|emitted|formula|fx_pair|initial|literal|logical|mutable|persist|sampled|sliding|storage|timeout|to_base|cached|called|inputs|latest|logged|sample|scalar|within|after|alias|count|empty|error|field|kwarg|never|scope|until|where|base|hold|none|over|skip|then|type|zero|for|gap|has|key|let|ttl|via|as|at|by|no|on|to|wm)\\b"
    },
    "words-builtin": {
      "comment": "[LLEX.9.6] and [LEXP.17.2]: the builtins and the aggregations.",
      "name": "support.function.ds",
      "match": "\\b(?:active_fraction|count_distinct|monotonic_ns|onset_rate|direction|pvariance|bool_and|count_of|integral|variance|bool_or|median|pstdev|dwell|first|round|stdev|last|mean|rate|abs|len|max|min|now|p10|p11|p12|p13|p14|p15|p16|p17|p18|p19|p20|p21|p22|p23|p24|p25|p26|p27|p28|p29|p30|p31|p32|p33|p34|p35|p36|p37|p38|p39|p40|p41|p42|p43|p44|p45|p46|p47|p48|p49|p50|p51|p52|p53|p54|p55|p56|p57|p58|p59|p60|p61|p62|p63|p64|p65|p66|p67|p68|p69|p70|p71|p72|p73|p74|p75|p76|p77|p78|p79|p80|p81|p82|p83|p84|p85|p86|p87|p88|p89|p90|p91|p92|p93|p94|p95|p96|p97|p98|p99|sum|p1|p2|p3|p4|p5|p6|p7|p8|p9)\\b"
    },
    "words-kwarg": {
      "comment": "[LLEX.9.6]: the kwarg words.",
      "name": "keyword.other.kwarg.ds",
      "match": "\\b(?:nocooldown|filter|retain|limit|value)\\b"
    },
    "number": {
      "patterns": [
        {
          "comment": "[LLEX.11.1]: HEX_LIT.",
          "name": "constant.numeric.integer.hexadecimal.ds",
          "match": "\\b0x[0-9A-Fa-f](?:_?[0-9A-Fa-f])*\\b"
        },
        {
          "comment": "[LLEX.11.1]: BIN_LIT.",
          "name": "constant.numeric.integer.binary.ds",
          "match": "\\b0b[01](?:_?[01])*\\b"
        },
        {
          "comment": "[LLEX.11.1]: OCT_LIT.",
          "name": "constant.numeric.integer.octal.ds",
          "match": "\\b0o[0-7](?:_?[0-7])*\\b"
        },
        {
          "comment": "[LLEX.12]: UNIT_LIT.",
          "name": "constant.numeric.unit.ds",
          "match": "\\b[0-9](?:_?[0-9])*(?:\\.[0-9](?:_?[0-9])*)?(?:[eE][+-]?[0-9](?:_?[0-9])*)?_?(?:[eE](?![+\\-0-9])[A-Za-z0-9_°′″ΩµÅμΩʹʺₙ]*|[ij][A-Za-z0-9_°′″ΩµÅμΩʹʺₙ]+|[A-DF-Za-df-hk-z°′″ΩµÅμΩʹʺ][A-Za-z0-9_°′″ΩµÅμΩʹʺₙ]*)"
        },
        {
          "comment": "[LLEX.11.2]: FLOAT_LIT, both sides of the point ([LLEX.11.2.1]).",
          "name": "constant.numeric.float.ds",
          "match": "\\b(?:[0-9](?:_?[0-9])*\\.[0-9](?:_?[0-9])*(?:[eE][+-]?[0-9](?:_?[0-9])*)?|[0-9](?:_?[0-9])*[eE][+-]?[0-9](?:_?[0-9])*)\\b"
        },
        {
          "comment": "[LLEX.11.1]: DEC_LIT.",
          "name": "constant.numeric.integer.decimal.ds",
          "match": "\\b[0-9](?:_?[0-9])*\\b"
        }
      ]
    },
    "operator": {
      "comment": "[LLEX.8.1.1] longest match: [LLEX.8.3.2]'s tokens, with `..`, `::` and `??` ([LLEX.10.8.5]), then the single characters.",
      "name": "keyword.operator.ds",
      "match": "->|\\.\\.|::|\\?\\?|==|!=|<=|>=|<<|>>|\\*\\*|//|[+\\-*/%<>|&^=:!?@~]"
    },
    "punctuation": {
      "name": "punctuation.ds",
      "match": "[()\\[\\]{},.]"
    }
  }
}
