# SPDX-FileCopyrightText: 2026 Dan Finster and the Desert Sage Contributors
# SPDX-License-Identifier: BSD-4-Clause OR AGPL-3.0-or-later
# libds.build — libds.a and the C suites that test it, as one graph rooted at
# the repository. release.build imports it by name and instantiates its units
# per release row.
#
# `libds.a` is a Product the test compiles consume, so a lane names its
# configuration once (`-D cflags_extra=…`, `-D re2=stub`, `-D alloc_header=…`)
# and the archive the tests link is the archive that configuration built.
#
# Each step runs in its own directory through `cwd`: `reads`, `makes` and
# `tool` are root-relative, and the argv is relative to the step's directory.
#
# The libds half:
#   1. a protoc-c generation per body set (the Proto table) -> *.pb-c.{c,h},
#   2. a cc compile per source (per-group -I flags carried in the Obj fact),
#   3. an `ld -r` partial link per group (one .o each, avoiding the GNU ar
#      basename collision),
#   4. an `ar rcs` over every top-level object and the combined groups ->
#      libds.a,
#   5. `lint` (the IALC alloc-routing guard) and the other checks at the end,
#      as `stamp` steps. The C example, harness.c, is ci.build's `c` gate.
#
# Targets, from the repository root:
#   build libds.build libds.a
#   build libds.build build_libds_all.stamp
#   build libds.build build_libds_tests.stamp    # impl suite, archive included
#   build libds.build build_libds_spec.stamp     # spec suite
#   build libds.build alloc_weak.stamp -D weak=1 # IALC.10, one -D per variant
#
# Every compile reads a representative body of the dsc and rfcs sets, so it
# orders after both generations.
#
# `port/ds_re2_stub.c` is matched by a single-file glob, so `-D re2` switches
# it in and out by the same mechanism as every other source.

# ds_re2.cc comes from the top-level `*.cc` glob, its `seam` "re2"; the rows
# here are the units every build needs whatever `re2` says, so their `seam` is
# empty.
table ObjCxx
  """One C++ compile unit: ds_re2.cc, the RE2 seam, from the top-level `*.cc` glob, and the two Float-text units, float_text/float_parse.cc over fast_float and float_text/float_shortest.cc over Dragonbox, rows because no build may lack them. `seam` is the LibdsRow `re2` value a row needs to compile the unit, or empty for every row. A separate schema from Obj because the C++ compile takes a different tool, -std and link deps."""
  obj                           src                            iflags                                                                                          seam
  float_text/float_parse.o      float_text/float_parse.cc      "-I../../../vendor -fno-exceptions -fno-rtti"                                                    ""
  float_text/float_shortest.o   float_text/float_shortest.cc   "-I../../../vendor/dragonbox/include -I../../../vendor -fno-exceptions -fno-rtti -Djkj=ds::jkj"  ""

# ── build params: -D overrides with defaults.
#
# The conditional params carry prefix/suffix rather than a whole token: the
# wrapper appears only when -D supplies a value, so an unset param contributes
# no flag at all.
#
# The graph is not isolated: a configured build (`-D cflags_extra=--coverage`,
# `-D alloc_mode=…`) writes libds.a in place, which is the file the tests link.
# The variant tag is in every step key, so a configured build cannot reuse a
# default build's objects.

param cc            = gcc
# libds is C except for its C++ units, and RE2's headers are C++17. A separate
# param from `cc`: a cross build sets the two independently, and `gcc foo.cc`
# links no C++ runtime.
param cxx           = g++
# `re2` selects which side of the RE2 seam is compiled: "re2" (default) builds
# ds_re2.cc against real RE2; "stub" builds port/ds_re2_stub.c instead and
# links no RE2. MSan needs every dependency instrumented, and the stub spares
# it an instrumented RE2.
#
# A param and not an `#ifdef`: a wrong value produces no ds_re2 symbols and the
# link fails, where a forgotten macro would give a runtime that matches nothing.
param re2           = re2
param ld            = ld
param ar            = ar
param ar_flags      = rcs
param protoc_c      = protoc-c
param cflags_extra  = ""
# Every libds compile, CORE-MATH's and musl's objects included, carries the
# exploit mitigations. `harden` is the portable set, on by default, so the
# projected Makefile and a source-bundle build are hardened; a row whose target
# cannot take it (wasm32, the microcontrollers) and the instrumented lanes
# (sanitizers, valgrind, coverage, the alloc and fuzz lanes, whose findings
# zero-initialised locals and FORTIFY would hide) set it empty. `harden_cfi` is
# the architecture's control-flow protection, which gcc refuses on another
# architecture, so it is empty by default and each row, and
# scripts/private/gate/gate.py from the machine it runs on, names it: a linker
# ANDs the CET and BTI notes of every object, so one object without them strips
# them from the whole program. No flag here touches a Float result, and
# -ffp-contract=off stays on every line.
param harden        = "-fstack-protector-strong -D_FORTIFY_SOURCE=3 -fstack-clash-protection -ftrivial-auto-var-init=zero"
param harden_cfi    = ""
param alloc_mode    = "" prefix "-DDS_ALLOC_MODE="
# The quotes are escaped because the command is split by POSIX shell rules
# (`shlex.split` in build-unit, `/bin/sh` in a Make recipe). Unescaped, the
# macro expands to a bare 1.2.3 instead of a string literal.
param version       = "" prefix "-DDS_LIBDS_VERSION=\\\"" suffix "\\\""
# The test suites' link line, one for all three suites. The MSan lane replaces
# it to drop `-lre2 -lstdc++` and link its own instrumented protobuf-c.
param ldlibs        = "-lprotobuf-c -lre2 -lstdc++ -lpthread -lm"
# IALC.10.4's macro build. `#include DS_ALLOC_HEADER` (ds_alloc.h) needs the
# macro to expand to a quoted filename, so the quotes are escaped as
# `version`'s are, and the value is a path relative to ds_alloc.h's own
# directory.
param alloc_header  = "" prefix "-DDS_ALLOC_HEADER=\\\"" suffix "\\\""

# ── the rows the archive is built for ────────────────────────────────────────
# Every compile, every `ld -r` combine and the archive below are instantiated
# once per LibdsRow. This file states one, CI's: its `id` is empty, so its step
# ids are unprefixed (`libds.a`, `dsc/loader.o`), and its `out` is
# runtime/src/libds. Each toolchain cell reads its param, so `-D cc=clang` and
# every other lane's `-D` reach it, and the projected Makefile sees the same
# recipes.
#
# A file that imports this one adds its own rows (`from libds import LibdsRow`,
# then `row LibdsRow` in an `each`): release.build does, one per release row,
# each with its own `id` prefix, `out`, `require` and toolchain.
#
# The `*_tool` columns are what build-unit hashes as each step's tool, and a
# tool has to resolve on the coordinator. For CI's row they are the commands
# themselves. A release row whose compiler is a wrapper names the interpreter
# that runs it.
#
# `version` is what the version object's compile is given for DS_LIBDS_VERSION:
# for CI's row the whole flag, prefix and quoting included, as the `version`
# param resolves it. It is a column because an importer reads the same
# `-D version`, and release.build's is the release's clean version, where an
# archive's provenance is `<version>+<sha>`. A release row force-includes a
# header that states it, and names that header in LibdsVersionInput, so the
# commit is in no build-wide `-D` and reaches that one compile alone.
#
# What a row does not vary: the protoc-c steps, one per set on the coordinator,
# whose bodies build-unit stages to a row's host because every compile reads
# them; `alloc_mode` and `alloc_header`, which are the build's; and everything
# after the archive (the suites, the alloc lanes, lint and the completeness
# guard), which reads CI's runtime/src/libds/libds.a.
table LibdsRow
  """One build of libds.a: `id` prefixes every step id, `out` is the directory its objects and archive are written to, `require` places its steps (empty: the coordinator), and the rest is its toolchain. `re2` is "re2" or "stub" and selects which side of the RE2 seam it compiles. `version` is the whole DS_LIBDS_VERSION flag, or empty."""
  id  out:mutable        require:mutable  cc:mutable  cxx:mutable  ld:mutable  ar:mutable  ar_flags:mutable  cflags_extra:mutable  harden:mutable  harden_cfi:mutable  re2:mutable  version:mutable  cc_tool:mutable  cxx_tool:mutable  ld_tool:mutable  ar_tool:mutable
  ""  runtime/src/libds  ""               {cc}        {cxx}        {ld}        {ar}        {ar_flags}        {cflags_extra}        {harden}        {harden_cfi}        {re2}        {version}        {cc}             {cxx}             {ld}             {ar}

# A file every compile of a row reads beside its sources: a compiler
# wrapper, the modules it imports, the row's vendor stamp. Read, so a change to
# any of them re-keys that row's objects. CI's row has none, so this file
# states no rows; an importer states its own.
table LibdsRowInput
  """A file every compile of a LibdsRow row reads: `row` is the row's `id`, `path` the file."""
  row  path

# A file the version object of a row reads and no other compile does: the
# header a release row's `version` force-includes. Read, so a new commit
# re-keys that one object and the archive, and nothing else of the row.
table LibdsVersionInput
  """A file a LibdsRow row's version object reads: `row` is the row's `id`, `path` the file."""
  row  path

# A step outside this file that compiles libds's sources again, the generated
# protoc-c bodies among them: a release's census of a row's conversions. It
# reads every body, so build-unit puts them in whichever tree it runs in. With
# a host running several steps at once, a step lands in a tree another step
# generated nothing in, and only what it declares is there. Its importer states
# the rows; CI's build states none.
table LibdsBodiesReader
  """A step that reads every generated protoc-c body, .pb-c.c and .pb-c.h: `step` is its id."""
  step

# Concurrent: every compile writes one `.o` nothing else writes, each `ld -r`
# group and `ar` write one file each, the protoc steps write disjoint
# directories, and each local step runs in its own slot clone.
graph concurrent

# ── proto-c generation ───────────────────────────────────────────────────────
# Each body set is declared once, in the Proto table, and every view of it is
# derived from it: the protoc argv, its outputs, the compile units and the
# combine fan-in. The generated *.pb-c.c are not globbed, since they do not
# exist until protoc runs; their names follow from the stem.
table Proto
  """One .proto in a protoc-c body set (`set` is "dsc", "rfcs" or "reader"). Membership is a selection, not a directory: a proto is in a set when libds code in that set includes its header, so a proto nothing reads stays out."""
  set   stem
  # DSC bodies (proto/*.proto -> dsc/*.pb-c.{c,h})
  dsc   alfa
  dsc   beta
  dsc   builtin_fn
  # `header.proto` and `stream_header.proto` both import it; the rfcs set reads
  # it through `-Idsc` (stream_header's ProtoIFlags row). libds decodes CAPB at
  # load ([RDSC.16.2]).
  dsc   capabilities
  dsc   common
  dsc   ds_source
  dsc   realtime_contract
  dsc   rete_expr
  dsc   header
  dsc   hydration
  dsc   line_span
  dsc   rule_cooldown
  dsc   rule_debug_name
  dsc   rule_source
  dsc   schema_def
  dsc   schema_logical
  dsc   schema_source
  dsc   schema_ttl
  dsc   series_backend_fifo_deque
  dsc   series_backend_monotonic_deque
  dsc   series_backend_reservoir
  dsc   series_backend_ring_buffer
  dsc   series_backend_welford_ewma
  dsc   series_backend_interval_pulse
  dsc   series_backend_numeric_integral
  dsc   slot
  dsc   term
  # RFCS fact-stream bodies (proto/*.proto -> rfcs/*.pb-c.{c,h})
  rfcs  stream_header
  rfcs  fact_assert
  rfcs  fact_retract
  rfcs  call_issued
  # `call_issued.proto` imports it for `Arg`.
  rfcs  fact_external
  rfcs  fact_emit
  rfcs  fact_withdraw
  rfcs  fact_publish
  rfcs  engine_error
  rfcs  type_error
  rfcs  bounds_error
  rfcs  engine_fault
  rfcs  cache_seed
  # The bodies only the generic atom reader needs, so that every registered
  # atom has a descriptor (reader/atom_descriptors.c). A set and a combined
  # object of their own, because a link pulls a combined object whole, and
  # these stay out of every engine link.
  reader  aot
  reader  dialect
  reader  doc_string
  # FCXT's body ([RFCS.24]). Only the generic reader includes it.
  reader  external_assert
  reader  pump_boundary
  reader  service_def
  reader  log_level
  reader  test_oracle
  reader  test_scenario
  # The `initial:` block's bodies ([LGRA.24]), here for the generic reader's
  # descriptor only: `dsc/loader.c` walks them with its own PBF reader.
  reader  initial

# The protoc steps run at the root, with no `cwd`. `{{objs}}` gives the
# root-relative input names; `{{inputs}}` would give a leaf's absolute path,
# which would put the checkout's location into the step key.
step dsc-protoc
  run {protoc_c} --proto_path=proto --c_out={{outputs:dir}} {{objs}}

step rfcs-protoc
  run {protoc_c} --proto_path=proto --c_out={{outputs:dir}} {{objs}}

step reader-protoc
  run {protoc_c} --proto_path=proto --c_out={{outputs:dir}} {{objs}}

# ── the derived views of a proto set. Each fires once per Proto row, so a stem
#    added to a set above produces all of them or none — they cannot disagree.
each Proto p
  extend {p.set}-protoc
    reads proto/{p.stem}.proto
    makes runtime/src/libds/{p.set}/{p.stem}.pb-c.c
    # The header is a declared output: a step runs in a slot clone, and only
    # its declared outputs come back to the checkout.
    makes runtime/src/libds/{p.set}/{p.stem}.pb-c.h

each Proto p
  with LibdsBodiesReader b
  extend {b.step}
    reads runtime/src/libds/{p.set}/{p.stem}.pb-c.c runtime/src/libds/{p.set}/{p.stem}.pb-c.h

# The bodies are generated once, above, and compiled and combined once per row.
each Proto p
  with LibdsRow r
  extend {r.id}{p.set}_combined.o
    reads {r.out}/{p.set}/{p.stem}.pb-c.o

# A generated body compiles against its own set's directory, unless it imports
# a body from another set: then it has a ProtoIFlags row.
each Proto p
  with no ProtoIFlags f where f.stem == p.stem
  row Obj
    obj    {p.set}/{p.stem}.pb-c.o
    src    {p.set}/{p.stem}.pb-c.c
    iflags "-I../libds -I{p.set} -Wno-unused-but-set-variable"
    seam   ""

each Proto p
  with ProtoIFlags f where f.stem == p.stem
  row Obj
    obj    {p.set}/{p.stem}.pb-c.o
    src    {p.set}/{p.stem}.pb-c.c
    iflags {f.iflags}
    seam   ""

table ProtoIFlags
  """A generated body whose include flags differ from its set's default, because its .proto imports a body declared in another set. protoc-c writes the import as a bare `#include "X.pb-c.h"`, so the importer's compile needs the other set's directory on its path. Keyed by stem."""
  stem           iflags:mutable
  # `stream_header.proto` imports `capabilities.proto`, a dsc body.
  stream_header  "-I../libds -Irfcs -Idsc -Wno-unused-but-set-variable"
  # `external_assert.proto` imports `fact_external.proto`, an rfcs body, and
  # through it `slot.proto`, a dsc body.
  external_assert  "-I../libds -Ireader -Irfcs -Idsc -Wno-unused-but-set-variable"
  # `fact_external.proto` imports `slot.proto`, a dsc body, and
  # `call_issued.proto` imports `fact_external.proto`.
  fact_external  "-I../libds -Irfcs -Idsc -Wno-unused-but-set-variable"
  call_issued    "-I../libds -Irfcs -Idsc -Wno-unused-but-set-variable"

# ── the compile units: obj, src, and per-file include flags ──────────────────
#
# The top level, rete/ and series/ are globbed, so a new source file there is
# compiled and archived with no edit here. rete/ and series/ have uniform
# include flags. The top level's take two values, so IFlags names the units
# that need -I../libds: the top-level block negates on it (`with no IFlags`)
# and its override joins it (`with IFlags`).
#
# dsc/, rfcs/ and reader/ keep explicit Obj rows, since they mix in the
# generated *.pb-c.c and a glob reads source trees only.
#
# `port/` is not covered by the `*.c` glob (globs are per directory), so the
# stub is globbed on its own at the RE2 seam below.

table IFlags
  """A top-level compile unit whose include flags differ from the default (""). Keyed by stem."""
  stem                  iflags:mutable
  dispatcher            -I../libds
  engine                -I../libds
  engine_clone          -I../libds
  wm_rete_bridge        -I../libds
  engine_rete_adapters  -I../libds
  fn                    -I../libds
  builtins              -I../libds

# `seam`, as ObjCxx's: the LibdsRow `re2` value a row needs to compile the
# unit, or empty for every row. The RE2 stub has one, and the version unit's,
# `version`, is no row's `re2`: the generic compile never takes it, and the
# version compile below does.
table Obj
  obj                       src                       iflags              seam
  version/libds_version.o   version/libds_version.c   -I../libds          version
  dsc/loader.o         dsc/loader.c         "-I../libds -Idsc"  ""
  dsc/rete_loader.o    dsc/rete_loader.c    -I../libds          ""
  dsc/dsrt_loader.o    dsc/dsrt_loader.c    -I../libds          ""
  dsc/ds_pb_alloc.o    dsc/ds_pb_alloc.c    "-I../libds -Idsc"  ""
  dsc/pbf_reader.o     dsc/pbf_reader.c     -I../libds          ""
  # Generated by scripts/private/gen/gen_atom_registry.py with its header. A
  # unit of its own so the table has one definition: `ds_pbf_lookup` returns
  # pointers into it.
  dsc/atom_registry.o  dsc/atom_registry.c  -I../libds          ""
  dsc/pbf_writer.o     dsc/pbf_writer.c     -I../libds          ""
  # -Idsc: the fact stream announces SchemaDef and Slot ([RFCS.5.1]), which are
  # dsc bodies.
  rfcs/codec.o         rfcs/codec.c         "-I../libds -Irfcs -Idsc"  ""
  # The generic atom reader and its generated descriptor table, which includes
  # a header from each of the three proto sets.
  reader/atom_reader.o      reader/atom_reader.c      "-I../libds -Ireader -Idsc -Irfcs"  ""
  reader/atom_descriptors.o reader/atom_descriptors.c "-I../libds -Ireader -Idsc -Irfcs"  ""

# ── glob matches → Obj. The compile below fires on these as on a table row.
#    The top level needs two blocks because its include flags are not uniform.
each glob runtime/src/libds/*.c m
  with no IFlags f where f.stem == m.stem
  row Obj
    obj    {m.stem}.o
    src    {m.stem}.c
    iflags ""
    seam   ""

each glob runtime/src/libds/*.c m
  with IFlags f where f.stem == m.stem
  row Obj
    obj    {m.stem}.o
    src    {m.stem}.c
    iflags {f.iflags}
    seam   ""

# The C++ half of the top level, with no per-file include flags: RE2's headers
# come from the toolchain's default search path. The unit is declared whatever
# a row's `re2` says; its `seam` gates its compile and its archive edge, per
# row, below.
each glob runtime/src/libds/*.cc m
  row ObjCxx
    obj    {m.stem}.o
    src    {m.stem}.cc
    iflags ""
    seam   re2

# The other side of the seam. `-D re2=stub` compiles port/ds_re2_stub.c and
# not ds_re2.cc, so the archive carries the ds_re2_* symbols with no RE2
# behind them. A libds.a built this way declines the `regex` form, so it is
# conformant only for a dialect that disables the form ([LREG.7.1],
# [LREG.8.1]). It is not shipped as a general libds.a.
#
# A glob with no metacharacter: being a GlobMatch is what lets `-D re2` switch
# this source like every other; a `reads` would consume it unconditionally.
#
# The archive edge is in the same block as the compile unit, so both follow
# one condition.
each glob runtime/src/libds/port/ds_re2_stub.c m
  with LibdsRow r where r.re2 == "stub"
  row Obj
    obj    port/{m.stem}.o
    src    port/{m.stem}.c
    iflags -I../libds
    seam   stub
  extend {r.id}libds.a
    reads {r.out}/port/{m.stem}.o

# Float text from vendored, unmodified code (vendor/README.md). Neither
# snapshot sits under src/libds, so each has its own compile here. ci.build's
# `vendor-digests` holds the snapshots to their recorded digests, not this
# graph: libds.a's closure is projected into the source bundle's Makefile,
# which cannot carry a stamp (scripts/private/makefile/gen_libds_makefile.py
# refuses one).
#
# Both units are C++ rows, not glob matches, because the top-level `*.cc` glob
# is gated on `re2` and every build needs these. Neither references a C++
# runtime, and `-fno-exceptions -fno-rtti` keeps it so: without them the
# compiler emits unwind tables and noexcept guards that need
# __gxx_personality_v0, __cxa_begin_catch and std::terminate, which the
# microcontroller rows do not link. The flags are on these rows and not on the
# ObjCxx step, because ds_re2.cc catches std::bad_alloc.
#
# Dragonbox's source file is #included by float_shortest.cc, so the library is
# one object and its sources are that object's reads.
#
# Its namespace is renamed at compile time, `jkj` to `ds::jkj`:
# dragonbox_to_chars.cpp instantiates `to_chars` for float and double, two
# strong definitions an integrator's own Dragonbox would collide with. In the
# vendored source the token `jkj` is only the namespace's name; its macros are
# `JKJ_*`. runtime/tests/libds/source/test_exports_ds_prefixed.py names any
# export without the prefix.

each LibdsRow r
  extend {r.id}float_text/float_parse.o
    reads vendor/fast_float/fast_float.h runtime/src/libds/float_fmt.h
  extend {r.id}float_text/float_shortest.o
    reads vendor/dragonbox/include/dragonbox/dragonbox.h
          vendor/dragonbox/include/dragonbox/dragonbox_to_chars.h
          vendor/dragonbox/source/dragonbox_to_chars.cpp runtime/src/libds/float_fmt.h
  extend {r.id}libds.a
    reads {r.out}/float_text/float_parse.o {r.out}/float_text/float_shortest.o

# CORE-MATH, the correctly rounded transcendentals ([LEXP.3.9.1]) and `**`
# ([LEXP.7.3a]), from unmodified upstream files committed under
# vendor/core-math/, the set vendor/source.lock pins. vendor/DIGESTS (the
# `vendor-digests` check) and scripts/private/tests/pins/test_vendor_source.py
# hold the committed bytes to the lock.
#
# The flags are the lock's, written out because a buildfile cannot read a
# file: `-O2 -std=gnu11 -ffp-contract=off` ([IARC.7.10]).
# scripts/private/tests/pins/test_vendor_source.py fails if this line and the
# lock part. What libds adds changes no result: the section flags, -g, -fPIC,
# the hardening flags and a lane's {r.cflags_extra}. Not -std=c99 or
# -D_POSIX_C_SOURCE: the 128-bit integer needs gnu11.
#
# The entry points are renamed at compile time, `cr_<fn>` to `ds_cm_<fn>`, so
# libds.a defines no name an integrator's own CORE-MATH could collide with.
#
# So are `printf` and `exit`, which `pow` and `atan2` reach only on upstream's
# unreachable worst-case branch: to the libds-private
# `ds_cm_unreachable_report` and `ds_cm_unreachable_exit`
# (core_math_unreachable.c). No member libds.build makes calls printf
# ([IARC.1.16]); scripts/private/release/printf_check.py holds each shipped
# archive to it.
#
# `-U_FORTIFY_SOURCE` comes last, after the hardening. Under FORTIFY, glibc
# defines `printf` as an always-inline wrapper around `__printf_chk`, so the
# rename above would rename the wrapper and the calls would reach
# `__printf_chk`. CORE-MATH has no buffer a FORTIFY check guards; every other
# mitigation stays on.
#
# Objects are `cm_<fn>.o`, never `<fn>.o`: an archive member is its basename,
# and a `log.o` beside libds's own objects would replace one.
table CoreMath
  """One CORE-MATH function libds compiles: its directory and file stem under src/binary64/ (`fn`), which is also the stem of the entry point `cr_<fn>`. The functions of [LEXP.3.9.1], and pow ([LEXP.7.3a]). FN_LN is `log`."""
  fn
  acos
  asin
  atan
  atan2
  cos
  cosh
  exp
  log
  log10
  log2
  pow
  sin
  sinh
  tan
  tanh

# The objects sit at the top of src/libds, where the projected Makefile's
# recipes run: a directory of their own would exist in no checkout, and Make
# does not create an output's directory. No source there is named `cm_*.c`,
# so the top-level glob compiles none of them twice.
each CoreMath c
  with LibdsRow r
  step {r.id}cm_{c.fn}.o
    cwd     runtime/src/libds
    tool    {r.cc_tool}
    require {r.require}
    run     {r.cc} -O2 -std=gnu11 -ffp-contract=off -ffunction-sections -fdata-sections -g -fPIC -Dcr_{c.fn}=ds_cm_{c.fn} -Dprintf=ds_cm_unreachable_report -Dexit=ds_cm_unreachable_exit -include core_math_fenv.h {r.harden} {r.harden_cfi} -U_FORTIFY_SOURCE {r.cflags_extra} -c -o {{outputs}} ../../../vendor/core-math/src/binary64/{c.fn}/{c.fn}.c
    reads   vendor/core-math/src/binary64/{c.fn}/{c.fn}.c runtime/src/libds/core_math_fenv.h
    makes   {r.out}/cm_{c.fn}.o
  extend {r.id}libds.a
    reads {r.out}/cm_{c.fn}.o

# The local headers each one includes, so editing the pin re-keys its object.
each LibdsRow r
  extend {r.id}cm_log.o
    reads vendor/core-math/src/binary64/log/dint.h
  extend {r.id}cm_log10.o
    reads vendor/core-math/src/binary64/log10/dint.h
  extend {r.id}cm_atan2.o
    reads vendor/core-math/src/binary64/atan2/tint.h
  extend {r.id}cm_pow.o
    reads vendor/core-math/src/binary64/pow/pow.h vendor/core-math/src/binary64/pow/dint.h
          vendor/core-math/src/binary64/pow/qint.h

# [IARC.7.14] — libds's own `fma`, on every row: musl's, from the files
# vendor/source.lock pins under [musl], committed under vendor/musl/ and
# compiled unmodified. `math.fma` ([LEXP.3.2.2]) calls it as `ds_libm_fma`,
# and so does every CORE-MATH object on a row whose baseline ISA has no fused
# multiply-add instruction (core_math_fenv.h), so no Float result depends on
# the C library the integrator links. `scalbn` is here because musl's `fma`
# calls it.
#
# The flags are the lock's [musl] cflags, written out for CoreMath's reason:
# `-O2 -std=gnu11 -ffp-contract=off -fno-builtin`.
# scripts/private/tests/pins/test_vendor_source.py fails if this line and the
# lock part. What libds adds changes no result: the section flags, -g, -fPIC,
# the hardening flags, and a lane's {r.cflags_extra}, which on a
# microcontroller row is the row's target.
#
# Renamed at compile time, `fma` to `ds_libm_fma` and `scalbn` to
# `ds_libm_scalbn`: the private names the microcontroller rows' map
# (mcu_libm/mcu_libm.redefine-syms) gives them, so the archive has one name on
# every row. Not by `objcopy`, which the projected Makefile cannot name and the
# wasm32 row's emsdk cannot apply to a wasm object. Both renames on both files:
# `fma.c` defines `fma` and calls `scalbn`.
#
# `-Imcu_libm` for `atomic.h`, the one header of musl's internal tree `fma.c`
# includes. Objects are `libm_<fn>.o`, for CoreMath's reason.
table Libm
  """One musl libm function libds compiles on every row ([IARC.7.14]): the stem of vendor/musl/src/math/<fn>.c, which defines `<fn>`, renamed `ds_libm_<fn>`."""
  fn
  fma
  scalbn

each Libm l
  with LibdsRow r
  step {r.id}libm_{l.fn}.o
    cwd     runtime/src/libds
    tool    {r.cc_tool}
    require {r.require}
    run     {r.cc} -O2 -std=gnu11 -ffp-contract=off -fno-builtin -ffunction-sections -fdata-sections -g -fPIC -Dfma=ds_libm_fma -Dscalbn=ds_libm_scalbn -Imcu_libm {r.harden} {r.harden_cfi} {r.cflags_extra} -c -o {{outputs}} ../../../vendor/musl/src/math/{l.fn}.c
    reads   vendor/musl/src/math/{l.fn}.c
    makes   {r.out}/libm_{l.fn}.o
  extend {r.id}libds.a
    reads {r.out}/libm_{l.fn}.o

each LibdsRow r
  extend {r.id}libm_fma.o
    reads runtime/src/libds/mcu_libm/atomic.h

each glob runtime/src/libds/rete/*.c m
  row Obj
    obj    rete/{m.stem}.o
    src    rete/{m.stem}.c
    iflags -I../libds
    seam   ""

each glob runtime/src/libds/series/*.c m
  row Obj
    obj    series/{m.stem}.o
    src    series/{m.stem}.c
    iflags "-I../libds -Iseries"
    seam   ""

# ── one cc per unit, per row and per the unit's `seam`: a unit with none
#    compiles for every row, and each side of the RE2 seam for the rows whose
#    `re2` names it. Every row compiles at runtime/src/libds, so `-Idsc` and the
#    rest mean the same for each; only `{r.out}` differs.
#
#    Each compiling step keeps its command on one line: test_fp_contract counts
#    them and checks each carries -ffp-contract=off.
#
#    `-ffunction-sections -fdata-sections` put each function and object in a
#    section of its own, so an integrator linking with `--gc-sections` drops
#    what it never calls. They change no result, and the `ld -r` partial links
#    keep the sections apart.
each Obj o
  with LibdsRow r where o.seam == "" or o.seam == r.re2
  step {r.id}{o.obj}
    cwd     runtime/src/libds
    tool    {r.cc_tool}
    require {r.require}
    run     {r.cc} {o.iflags} -O2 -g -Wall -Wextra -Wno-unused-parameter -std=c99 -ffp-contract=off -ffunction-sections -fdata-sections -D_POSIX_C_SOURCE=200809L -I../../include -fPIC {alloc_mode} {alloc_header} {r.harden} {r.harden_cfi} {r.cflags_extra} -c -o {{outputs}} {o.src}
    reads   runtime/src/libds/{o.src} runtime/src/libds/dsc/common.pb-c.c runtime/src/libds/rfcs/stream_header.pb-c.c
    makes   {r.out}/{o.obj}

# ── the one unit that carries the version. A row's `version` is the whole
#    DS_LIBDS_VERSION flag, and in a release it names the commit, so it is on
#    this compile alone: every other object's command is the same at any
#    commit, and a new commit recompiles this unit and relinks the archive.
#    Its archive edge is here, beside it, under the same condition.
each Obj o
  with LibdsRow r where o.seam == "version"
  step {r.id}{o.obj}
    cwd     runtime/src/libds
    tool    {r.cc_tool}
    require {r.require}
    run     {r.cc} {o.iflags} -O2 -g -Wall -Wextra -Wno-unused-parameter -std=c99 -ffp-contract=off -ffunction-sections -fdata-sections -D_POSIX_C_SOURCE=200809L -I../../include -fPIC {r.version} {r.harden} {r.harden_cfi} {r.cflags_extra} -c -o {{outputs}} {o.src}
    reads   runtime/src/libds/{o.src} runtime/src/libds/version_series.h
    makes   {r.out}/{o.obj}
  extend {r.id}libds.a
    reads {r.out}/{o.obj}

each Obj o
  with LibdsRow r where o.seam == "version"
  with LibdsVersionInput i where i.row == r.id
  extend {r.id}{o.obj}
    reads {i.path}

# ── the header `alloc_header` names, read by every compile that includes it.
#    ds_alloc.h includes it through `#include DS_ALLOC_HEADER`, which
#    gen-header-deps.py cannot follow, so the generated block below never lists
#    it. Its one value in this tree is alloc-conformance's macro leg's,
#    ds_probe_macros.h (scripts/private/gate/gate.py), which includes
#    alloc_probe.h. scripts/private/tests/pins/test_libds_alloc_header.py holds
#    the pair to gate.py's value. A build that names another header declares it
#    here.
each Obj o when alloc_header
  with LibdsRow r where o.seam == "" or o.seam == r.re2
  extend {r.id}{o.obj}
    reads runtime/tests/libds/alloc_conformance/ds_probe_macros.h runtime/tests/libds/alloc_conformance/alloc_probe.h

# ── the C++ compile: -std=c++17 (RE2's headers require it), no
#    -D_POSIX_C_SOURCE (libstdc++ makes its own choice), and no read of the
#    protoc-c representatives, because the C++ units include no generated
#    header. `cflags_extra` is threaded through, so the instrumented lanes
#    cover these units too.
each ObjCxx o
  with LibdsRow r where o.seam == "" or o.seam == r.re2
  step {r.id}{o.obj}
    cwd     runtime/src/libds
    tool    {r.cxx_tool}
    require {r.require}
    run     {r.cxx} {o.iflags} -O2 -g -Wall -Wextra -Wno-unused-parameter -std=c++17 -ffp-contract=off -ffunction-sections -fdata-sections -I../../include -fPIC {r.harden} {r.harden_cfi} {r.cflags_extra} -c -o {{outputs}} {o.src}
    reads   runtime/src/libds/{o.src}
    makes   {r.out}/{o.obj}

# ── what every compile of a row reads beyond its sources (LibdsRowInput) ──────
#    The version object's too: it runs through the row's compiler wrapper.
each Obj o
  with LibdsRow r where o.seam == "" or o.seam == r.re2 or o.seam == "version"
  with LibdsRowInput i where i.row == r.id
  extend {r.id}{o.obj}
    reads {i.path}

each ObjCxx o
  with LibdsRow r where o.seam == "" or o.seam == r.re2
  with LibdsRowInput i where i.row == r.id
  extend {r.id}{o.obj}
    reads {i.path}

each CoreMath c
  with LibdsRow r
  with LibdsRowInput i where i.row == r.id
  extend {r.id}cm_{c.fn}.o
    reads {i.path}

each Libm l
  with LibdsRow r
  with LibdsRowInput i where i.row == r.id
  extend {r.id}libm_{l.fn}.o
    reads {i.path}

# ── partial-link each subdir group into one object (ld -r), per row ───────────
#    The rete and series fan-ins take one input per glob match, so a new
#    rete/*.c is compiled and linked in.
each LibdsRow r
  step {r.id}dsc_combined.o
    cwd     runtime/src/libds
    tool    {r.ld_tool}
    require {r.require}
    run     {r.ld} -r -o {{outputs}} {{inputs}}
    reads   {r.out}/dsc/loader.o {r.out}/dsc/rete_loader.o {r.out}/dsc/dsrt_loader.o
            {r.out}/dsc/ds_pb_alloc.o {r.out}/dsc/pbf_reader.o {r.out}/dsc/atom_registry.o {r.out}/dsc/pbf_writer.o
    makes   {r.out}/dsc_combined.o
  step {r.id}series_combined.o
    cwd     runtime/src/libds
    tool    {r.ld_tool}
    require {r.require}
    run     {r.ld} -r -o {{outputs}} {{inputs}}
    makes   {r.out}/series_combined.o
  step {r.id}rete_combined.o
    cwd     runtime/src/libds
    tool    {r.ld_tool}
    require {r.require}
    run     {r.ld} -r -o {{outputs}} {{inputs}}
    makes   {r.out}/rete_combined.o
  step {r.id}rfcs_combined.o
    cwd     runtime/src/libds
    tool    {r.ld_tool}
    require {r.require}
    run     {r.ld} -r -o {{outputs}} {{inputs}}
    reads   {r.out}/rfcs/codec.o
    makes   {r.out}/rfcs_combined.o
  # The generic atom reader, its own archive member. A link that never calls
  # ds_rfcs_visit_atom pulls neither this nor the reader proto set.
  step {r.id}reader_combined.o
    cwd     runtime/src/libds
    tool    {r.ld_tool}
    require {r.require}
    run     {r.ld} -r -o {{outputs}} {{inputs}}
    reads   {r.out}/reader/atom_reader.o {r.out}/reader/atom_descriptors.o
    makes   {r.out}/reader_combined.o
  # ── the archive: libds.a over every top-level object and the combined
  # groups. A {{inputs}} fan-in, so a new top-level object is archived with no
  # edit here; the combined groups are step outputs and stay explicit. Member
  # order in an ar archive carries no meaning.
  step {r.id}libds.a
    cwd     runtime/src/libds
    tool    {r.ar_tool}
    require {r.require}
    run     {r.ar} {r.ar_flags} {{outputs}} {{inputs}}
    reads   {r.out}/dsc_combined.o {r.out}/series_combined.o {r.out}/rete_combined.o {r.out}/rfcs_combined.o
            {r.out}/reader_combined.o
    makes   {r.out}/libds.a

each glob runtime/src/libds/series/*.c m
  with LibdsRow r
  extend {r.id}series_combined.o
    reads {r.out}/series/{m.stem}.o

each glob runtime/src/libds/rete/*.c m
  with LibdsRow r
  extend {r.id}rete_combined.o
    reads {r.out}/rete/{m.stem}.o

each glob runtime/src/libds/*.c m
  with LibdsRow r
  extend {r.id}libds.a
    reads {r.out}/{m.stem}.o

# The C++ objects join the same fan-in, gated on `re2` per row as their
# compile is: a fan-in that did not follow its producer's condition would
# archive a ds_re2.o an earlier build left on disk.
each glob runtime/src/libds/*.cc m
  with LibdsRow r where r.re2 == "re2"
  extend {r.id}libds.a
    reads {r.out}/{m.stem}.o

# The stub's archive edge is in its own block, beside its compile unit, at the
# RE2 seam above.

# ── lint and the completeness guard. libds.a does not gate on lint;
#    build_libds_all.stamp pulls in both.

# lint — the IALC alloc-routing guard. `stamp` turns its pass/fail into a stamp
# Product. It and the completeness guard below are in scripts/libds/, which
# the public tree keeps (PUBLICATION.toml).
step build_lint.stamp
  cwd   runtime/src/libds
  stamp
  run   python3 ../../../scripts/libds/lint_alloc_routing.py
  reads scripts/libds/lint_alloc_routing.py

# completeness guard — every source and generated proto is declared in this
# buildfile.
step build_libds_complete.stamp
  cwd   runtime/src/libds
  stamp
  run   python3 ../../../scripts/libds/check_libds_bu_complete.py
  reads libds.build scripts/libds/check_libds_bu_complete.py

# libds.a, lint and the completeness guard.
step build_libds_all.stamp
  cwd   runtime/src/libds
  stamp
  run   true
  reads runtime/src/libds/libds.a build_lint.stamp build_libds_complete.stamp

# ── each object reads exactly the headers it transitively includes, so editing
#    a header rebuilds only the objects that include it.
# >>> generated by gen-header-deps.py — do not edit by hand >>>
# Per-object transitive header closures, audited from the real #include graph.
each LibdsRow r
  extend {r.id}builtins.o
    reads runtime/include/libds.h runtime/src/libds/builtin_fn.h runtime/src/libds/cache.h
          runtime/src/libds/clock.h runtime/src/libds/core_math.h runtime/src/libds/dispatcher.h
          runtime/src/libds/ds_alloc.h runtime/src/libds/ds_re2.h runtime/src/libds/ds_text.h
          runtime/src/libds/engine.h runtime/src/libds/float_fmt.h runtime/src/libds/fn.h
          runtime/src/libds/int_ops.h runtime/src/libds/internal/json.h runtime/src/libds/oa.h
          runtime/src/libds/recorder.h runtime/src/libds/rete/action.h
          runtime/src/libds/rete/adapters.h runtime/src/libds/rete/agenda.h
          runtime/src/libds/rete/alpha.h runtime/src/libds/rete/arena.h
          runtime/src/libds/rete/beta.h runtime/src/libds/rete/engine.h
          runtime/src/libds/rete/eval.h runtime/src/libds/rete/expr.h runtime/src/libds/rete/fact.h
          runtime/src/libds/rete/intern.h runtime/src/libds/rete/pool.h
          runtime/src/libds/rete/schema.h runtime/src/libds/rete/schema_reg.h
          runtime/src/libds/rete/terminal.h runtime/src/libds/rete/tms.h
          runtime/src/libds/rete/token.h runtime/src/libds/rete/val.h
          runtime/src/libds/rete/wm_rete.h runtime/src/libds/rfcs/atoms.h
          runtime/src/libds/schema.h runtime/src/libds/series/backend.h
          runtime/src/libds/series/dispatch.h runtime/src/libds/series/registry.h
          runtime/src/libds/series/state.h runtime/src/libds/telemetry.h runtime/src/libds/wm.h
  extend {r.id}cache.o
    reads runtime/include/libds.h runtime/src/libds/cache.h runtime/src/libds/ds_alloc.h
          runtime/src/libds/oa.h
  extend {r.id}clock.o
    reads runtime/include/libds.h runtime/src/libds/cache.h runtime/src/libds/clock.h
          runtime/src/libds/dispatcher.h runtime/src/libds/engine.h runtime/src/libds/oa.h
          runtime/src/libds/recorder.h runtime/src/libds/rfcs/atoms.h runtime/src/libds/schema.h
          runtime/src/libds/series/backend.h runtime/src/libds/series/dispatch.h
          runtime/src/libds/series/registry.h runtime/src/libds/series/state.h
          runtime/src/libds/telemetry.h runtime/src/libds/wm.h
  extend {r.id}copyright.o
    reads runtime/include/libds.h
  extend {r.id}core_math_unreachable.o
    reads runtime/src/libds/core_math.h
  extend {r.id}dispatcher.o
    reads runtime/include/libds.h runtime/src/libds/builtin_fn.h runtime/src/libds/cache.h
          runtime/src/libds/clock.h runtime/src/libds/dispatcher.h runtime/src/libds/ds_alloc.h
          runtime/src/libds/ds_re2.h runtime/src/libds/ds_text.h runtime/src/libds/engine.h
          runtime/src/libds/float_fmt.h runtime/src/libds/fn.h runtime/src/libds/internal/json.h
          runtime/src/libds/oa.h runtime/src/libds/recorder.h runtime/src/libds/rete/action.h
          runtime/src/libds/rete/adapters.h runtime/src/libds/rete/agenda.h
          runtime/src/libds/rete/arena.h runtime/src/libds/rete/engine.h
          runtime/src/libds/rete/expr.h runtime/src/libds/rete/fact.h
          runtime/src/libds/rete/intern.h runtime/src/libds/rete/pool.h
          runtime/src/libds/rete/schema.h runtime/src/libds/rete/schema_reg.h
          runtime/src/libds/rete/terminal.h runtime/src/libds/rete/tms.h
          runtime/src/libds/rete/token.h runtime/src/libds/rete/val.h
          runtime/src/libds/rete/wm_rete.h runtime/src/libds/rfcs/atoms.h
          runtime/src/libds/schema.h runtime/src/libds/series/backend.h
          runtime/src/libds/series/dispatch.h runtime/src/libds/series/registry.h
          runtime/src/libds/series/state.h runtime/src/libds/telemetry.h runtime/src/libds/wm.h
  extend {r.id}ds_alloc.o
    reads runtime/src/libds/ds_alloc.h
  extend {r.id}ds_text.o
    reads runtime/src/libds/ds_text.h runtime/src/libds/float_fmt.h
  extend {r.id}engine.o
    reads runtime/include/libds.h runtime/src/libds/builtin_fn.h runtime/src/libds/cache.h
          runtime/src/libds/clock.h runtime/src/libds/dispatcher.h runtime/src/libds/ds_alloc.h
          runtime/src/libds/ds_re2.h runtime/src/libds/ds_text.h runtime/src/libds/engine.h
          runtime/src/libds/fn.h runtime/src/libds/internal/json.h runtime/src/libds/oa.h
          runtime/src/libds/recorder.h runtime/src/libds/rete/adapters.h
          runtime/src/libds/rete/agenda.h runtime/src/libds/rete/arena.h
          runtime/src/libds/rete/engine.h runtime/src/libds/rete/fact.h
          runtime/src/libds/rete/intern.h runtime/src/libds/rete/pool.h
          runtime/src/libds/rete/schema.h runtime/src/libds/rete/tms.h
          runtime/src/libds/rete/token.h runtime/src/libds/rete/val.h
          runtime/src/libds/rete/wm_rete.h runtime/src/libds/rfcs/atoms.h
          runtime/src/libds/rfcs/rfcs.h runtime/src/libds/schema.h
          runtime/src/libds/series/backend.h runtime/src/libds/series/builtin_backends.h
          runtime/src/libds/series/dispatch.h runtime/src/libds/series/registry.h
          runtime/src/libds/series/state.h runtime/src/libds/telemetry.h runtime/src/libds/wm.h
  extend {r.id}engine_clone.o
    reads runtime/include/libds.h runtime/src/libds/builtin_fn.h runtime/src/libds/cache.h
          runtime/src/libds/clock.h runtime/src/libds/dispatcher.h runtime/src/libds/ds_alloc.h
          runtime/src/libds/ds_re2.h runtime/src/libds/ds_text.h runtime/src/libds/engine.h
          runtime/src/libds/fn.h runtime/src/libds/oa.h runtime/src/libds/recorder.h
          runtime/src/libds/rete/action.h runtime/src/libds/rete/adapters.h
          runtime/src/libds/rete/agenda.h runtime/src/libds/rete/arena.h
          runtime/src/libds/rete/clone.h runtime/src/libds/rete/engine.h
          runtime/src/libds/rete/expr.h runtime/src/libds/rete/fact.h
          runtime/src/libds/rete/intern.h runtime/src/libds/rete/pool.h
          runtime/src/libds/rete/schema.h runtime/src/libds/rete/tms.h runtime/src/libds/rete/val.h
          runtime/src/libds/rfcs/atoms.h runtime/src/libds/schema.h
          runtime/src/libds/series/backend.h runtime/src/libds/series/dispatch.h
          runtime/src/libds/series/registry.h runtime/src/libds/series/state.h
          runtime/src/libds/telemetry.h runtime/src/libds/wm.h
  extend {r.id}engine_rete_adapters.o
    reads runtime/include/libds.h runtime/src/libds/builtin_fn.h runtime/src/libds/cache.h
          runtime/src/libds/clock.h runtime/src/libds/dispatcher.h runtime/src/libds/ds_alloc.h
          runtime/src/libds/ds_re2.h runtime/src/libds/ds_text.h runtime/src/libds/engine.h
          runtime/src/libds/fn.h runtime/src/libds/internal/json.h runtime/src/libds/oa.h
          runtime/src/libds/recorder.h runtime/src/libds/rete/action.h
          runtime/src/libds/rete/adapters.h runtime/src/libds/rete/agenda.h
          runtime/src/libds/rete/alpha.h runtime/src/libds/rete/arena.h
          runtime/src/libds/rete/beta.h runtime/src/libds/rete/engine.h
          runtime/src/libds/rete/eval.h runtime/src/libds/rete/expr.h runtime/src/libds/rete/fact.h
          runtime/src/libds/rete/intern.h runtime/src/libds/rete/pool.h
          runtime/src/libds/rete/schema.h runtime/src/libds/rete/schema_reg.h
          runtime/src/libds/rete/terminal.h runtime/src/libds/rete/tms.h
          runtime/src/libds/rete/token.h runtime/src/libds/rete/val.h
          runtime/src/libds/rete/wm_rete.h runtime/src/libds/rfcs/atoms.h
          runtime/src/libds/rfcs/rfcs.h runtime/src/libds/schema.h
          runtime/src/libds/series/backend.h runtime/src/libds/series/dispatch.h
          runtime/src/libds/series/registry.h runtime/src/libds/series/state.h
          runtime/src/libds/telemetry.h runtime/src/libds/wm.h
  extend {r.id}float_fmt.o
    reads runtime/src/libds/ds_text.h runtime/src/libds/float_fmt.h
