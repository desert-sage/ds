# ══ the test suites ══════════════════════════════════════════════════════════
# ══ section: impl ════════════════════════════════════════════════════════════
# The libds impl unit tests. Each test compiles against libds.a and runs as a
# check step, so an unchanged test (same source, same libds.a) skips. From the
# repository root:
#
#   build libds.build build_libds_tests.stamp                 # build + run every impl test
#   build libds.build build_libds_tests.stamp \
#       -D runner="env DS_WCET_ASSERT=0 valgrind --leak-check=no -q"   # vg lane
#   build libds.build build_libds_tests.stamp -D leak_lane=1 \
#       -D runner="valgrind --leak-check=full --errors-for-leak-kinds=all --error-exitcode=99 -q"
#                                                    # valgrind-leak (teardown-clean subset)
#   build libds.build build_libds_tests.stamp -D leak_lane=1 \
#       -D cflags_extra="-fsanitize=address -fno-omit-frame-pointer"   # asan/LSan (same subset)
#
# The lanes: plain (every test), vg (-D runner, the vg "yes" subset, memory
# safety), and the two leak lanes (-D leak_lane, the leak "yes" teardown-clean
# subset): valgrind-leak (--leak-check=full via -D runner) and asan (built with
# -fsanitize=address, run under ASAN_OPTIONS).
#
# No lane asserts a wall-clock budget: under valgrind, or beside the rest of a
# parallel build, a timing test measures the host and not the engine.
# DS_WCET_ASSERT=1 opts in (test_rete4_wcet.c); the vg runner's `=0` states
# the vg lane's reason.
#
# Enumerated: runtime/tests/libds/source/test_every_c_test_is_built.py fails on
# a test_*.c with no row.
#
# Safe to run wide: one binary and one stamp per test, no two steps write the
# same file, and libds.a is read-only to all of them. The run blocks are
# mutually exclusive per test on -D runner, so a test has one stamp-producing
# step whichever lane runs. No impl test writes a scratch file.

table ImplTest
  name                        wrap  vg   leak
  test_action_events          ""    yes  no
  # leak "yes": a record nested 100 000 deep is refused before the unpack, and
  # the asan lane's leak subset runs that on a sanitized stack.
  test_assert_external        ""    yes  yes
  test_builtin_coverage       ""    yes  no
  test_cache                  ""    yes  no
  test_clock_basic            ""    yes  no
  test_dispatcher_assert      ""    yes  no
  test_dispatcher_cache       ""    yes  no
  test_dispatcher_log         ""    yes  no
  # leak "yes": [RDSC.11.4]'s case of a join test 100 000 Exprs deep, refused
  # before protobuf-c's unbounded unpack, runs on a sanitized stack in the asan
  # lane's leak subset ([RDSC.9.9]).
  test_dsc_basic              ""    yes  yes
  test_engine_basic           ""    yes  no
  test_engine_clone           ""    yes  no
  test_engine_rete_integration ""   yes  no
  test_fact_stamps            ""    yes  no
  test_fault_emission         ""    yes  no
  test_float_fmt              ""    yes  no
  # vg "no": valgrind does not emulate a non-nearest rounding mode faithfully,
  # which is the test's subject.
  test_fp_mode                ""    no   no
  # leak "yes": its subject is a failure path that frees everything it
  # allocated.
  test_iarc_3_2_5_rete_create_cleanup "" yes yes
  test_intern_borrowers       ""    yes  yes
  test_intern_enforcement     ""    no   no
  test_intern_fuzz            ""    yes  yes
  test_intern_unit            ""    yes  yes
  # Its subject is a read of a freed fact, which only valgrind and ASan see, so
  # vg and leak are "yes".
  test_iret_11_3_refract_after_withdraw "" yes yes
  test_iret_12_2_self_ending_match "" yes no
  test_iret_19_4_one_tick_per_pump "" yes no
  test_json_basic             ""    yes  no
  test_json_slot_ownership    ""    yes  no
  test_latest_value           ""    yes  no
  test_ldet_2_7_config_precondition "" yes no
  test_ldet_5_11_corr_sweep   ""    yes  no
  test_ldet_5_11_ttl_sweep    ""    yes  no
  test_lerr_9_5_fault_replace_strings "" yes no
  test_lfac_2_5_1_json_bytes_equality ""  yes  no
  test_lfac_2_5_1_json_key_noop ""  yes  no
  test_lfac_2_5_3_emit_supersede ""  yes  no
  test_lfac_2_5_3_host_upsert_refused ""  yes  no
  test_lnul_3_4_root_null_json ""   yes  no
  test_ncbk_1_5_log_fire_and_forget  ""  yes  no
  test_ncbk_2_12_firing_timetag ""  yes  no
  test_ndbg_4_1_rule_filter   ""    yes  no
  test_ndet_8_2_replay_no_effect_callbacks ""  yes  no
  # vg "yes": if register_schema borrowed the caller's strings, the read after
  # the caller frees them would be a use-after-free under valgrind.
  test_nfct_1_2_register_copies ""  yes  no
  test_nlfc_8_3_clone_no_callbacks ""  yes  no
  test_nfct_1_4_3_engine_role ""    yes  no
  test_nfct_2_11_refusal_order ""   yes  no
  test_nfct_2_6_1_ttl_range   ""    yes  no
  test_nfct_6_4_fact_find     ""    yes  no
  test_nmet_4_4_owed_metrics  ""    yes  no
  test_nmet_4_1_inventory     ""    yes  no
  test_nooprec_volume         ""    yes  no
  test_nrtm_3_1_wm_max_advisory ""  yes  no
  test_nrtm_6_3_contract_dump ""    yes  no
  test_nrtm_9_1_undeclared    ""    yes  no
  test_ordinal_reachability   ""    yes  no
  test_oa                     ""    yes  no
  test_rdsc_4a_9_5_operands   ""    yes  no
  test_reentry                ""    yes  no
  # vg "no" on the allocator wraps: a wrap collides with valgrind's allocator.
  test_rete4_alloc            "-Wl,--wrap=malloc,--wrap=calloc,--wrap=realloc"  no  no
  test_recorder_defer_oom     "-Wl,--wrap=realloc"  no  no
  test_ndbg_5_1_justifiers_oom "-Wl,--wrap=realloc,--wrap=strdup,--wrap=free"  no  no
  test_rete4_wcet             ""    yes  no
  test_rete5_lazy_rt          ""    yes  no
  test_rete7_index_presz      ""    yes  no
  test_rete8_series_lock      ""    yes  no
  test_rete_action            ""    yes  no
  test_rete_adapters          ""    yes  no
  test_rete_alpha             ""    yes  no
  test_rete_beta              ""    yes  no
  test_rete_builtins          ""    yes  no
  test_rete_clone             ""    yes  no
  test_rete_deadline_heap     ""    yes  no
  test_rete_dedup_wedge       ""    yes  no
  test_rete_engine_basic      ""    yes  no
  test_rete_expr_eval         ""    yes  no
  test_rete_go_live           ""    yes  no
  test_rete_intern_seal       ""    yes  yes
  test_rete_loader            ""    yes  no
  # vg "no": the test asks which patterns RE2 accepts, which valgrind cannot
  # answer, and a compile under valgrind needs valgrind-re2.supp.
  test_re2_surface            ""    no   no
  test_re2_group_names        ""    no   no
  # The program defines its own operator new that throws on demand, and its
  # frames lie between the throw and ds_re2.cc's catch, so `wrap` carries
  # -fexceptions. vg "no": valgrind replaces operator new, so nothing could be
  # injected. leak "no": RE2 is not documented exception-safe, so a pattern
  # whose match failed may leak its partial state; the engine halts on it.
  test_re2_alloc_failure      "-fexceptions"  no  no
  test_rete_pool              ""    yes  no
  # vg "no": valgrind does not guarantee bit-identical floating point, and
  # these tests ask which bits.
  test_ulp_envelope           ""    no   no
  test_ulp_pow                ""    no   no
  test_pbf_reader             ""    yes  no
  test_pbf_writer             ""    yes  no
  test_rete_presz             ""    yes  no
  test_rete_ridx_churn        ""    yes  no
  test_rete_rt_guards         ""    yes  no
  test_rete_schema_reg        ""    yes  no
  test_rete_terminal_agenda   ""    yes  no
  test_rete_time              ""    yes  no
  test_rete_tms               ""    yes  no
  test_rete_token_budget      ""    yes  no
  test_rete_wm                ""    yes  no
  # The wrap scripts the monotonic clock; valgrind does not interpose
  # clock_gettime, so vg stays "yes".
  test_rfcs_6_7_one_clock_read "-Wl,--wrap=clock_gettime"  yes  no
  test_rfcs_chunked           ""    yes  no
  test_rfcs_codec             ""    yes  no
  test_rfcs_fact              ""    yes  no
  # leak "yes": a body that fails on an absent Json field after an earlier Json
  # field parsed must free that tree.
  test_rfcs_6_3_absent_json   ""    yes  yes
  # leak "yes": the asan lane's subset reads each body past its end if a
  # decoder's bound check wraps.
  test_rfcs_len_wrap          ""    yes  yes
  test_rfcs_golden            ""    yes  no
  # leak "yes" ([RDSC.9.9]): an ExternalAssert and a CallIssued nested 100 000
  # deep are refused before the unpack, and the asan lane's leak subset runs
  # that on a sanitized stack.
  test_rfcs_reader            ""    yes  yes
  test_rfcs_record            ""    yes  no
  test_rfcs_record_chain      ""    yes  no
  test_rfcs_record_failure    ""    yes  no
  test_rfcs_prelude           ""    yes  no
  test_rfcs_replay            ""    yes  no
  test_rfcs_replay_determinism ""   yes  no
  test_rfcs_slot_kinds        ""    yes  no
  test_rfcs_announced_body    ""    yes  no
  test_rfcs_ttl_replay        ""    yes  no
  test_rfcs_ttl_record        ""    yes  no
  test_rfcs_fwth_record       ""    yes  no
  test_rfcs_fault_record      ""    yes  no
  test_rfcs_verify            ""    yes  no
  test_rfstall                ""    yes  no
  test_sbwe_cumulative        ""    yes  no
  test_schema_basic           ""    yes  no
  test_reservoir_clone        ""    yes  no
  test_series_builtin_registered ""  yes  no
  test_series_backend_internal ""    yes  no
  test_series_no_backing      ""    yes  no
  test_series_read_held_sample "-Wl,--wrap=clock_gettime"  yes  no
  test_slot_ownership         ""    yes  no
  test_slot_type_mapping      ""    yes  no
  test_stream_status          ""    yes  no
  test_telemetry_basic        ""    yes  no
  test_tms_id_spaces          ""    yes  no
  test_two_clocks             ""    yes  no
  test_version_macros         ""    yes  no
  test_wm_basic               ""    yes  no
  test_wm_slot_typing         ""    yes  no

# Build each test: compile test_X.c against libds.a. {t.wrap} carries the
# test's own flags.
each ImplTest t
  step {t.name}
    cwd   runtime/tests/libds/impl
    run   {cc} -O0 -g -Wall -Wextra -Wno-unused-parameter -std=c99 -ffp-contract=off -D_POSIX_C_SOURCE=200809L
          -I../../../include -I../../../src/libds -I../../../src/libds/dsc {cflags_extra}
          {t.wrap} -o {t.name} {t.name}.c ../../../src/libds/libds.a {ldlibs}
    reads runtime/tests/libds/impl/{t.name}.c runtime/src/libds/libds.a
    makes runtime/tests/libds/impl/{t.name}

# The tests that #include pbf_vectors.h read it. It is generated from
# specs/conformance/PBF_FRAMING_VECTORS.json, so it changes without either .c
# changing; undeclared, the compile would cache-hit and the old binary would
# run. Named per test because only these tests include it.
extend test_pbf_reader
  reads runtime/tests/libds/impl/pbf_vectors.h

extend test_pbf_writer
  reads runtime/tests/libds/impl/pbf_vectors.h

# [LDET.1.10] — the tests that #include test_ds_version.h, named per test for
# the same reason. The header lets them ask the linked libds for its version:
# `version` reaches the archive's compiles only, not the tests'.
extend test_dsc_basic
  reads runtime/tests/libds/impl/test_ds_version.h

extend test_rete5_lazy_rt
  reads runtime/tests/libds/impl/test_ds_version.h

extend test_rfcs_codec
  reads runtime/tests/libds/impl/test_ds_version.h

extend test_rfcs_golden
  reads runtime/tests/libds/impl/test_ds_version.h

extend test_rfcs_record
  reads runtime/tests/libds/impl/test_ds_version.h

# The generated protobuf-c headers each test includes, with what they import
# (ds_source and schema_def import common; header imports capabilities). A
# step runs in a clean clone, so a header no step declares is not there.
extend test_dsc_basic
  reads runtime/src/libds/dsc/common.pb-c.h runtime/src/libds/dsc/ds_source.pb-c.h
        runtime/src/libds/dsc/header.pb-c.h runtime/src/libds/dsc/hydration.pb-c.h
        runtime/src/libds/dsc/line_span.pb-c.h runtime/src/libds/dsc/rule_cooldown.pb-c.h
        runtime/src/libds/dsc/rule_debug_name.pb-c.h runtime/src/libds/dsc/rule_source.pb-c.h
        runtime/src/libds/dsc/schema_def.pb-c.h runtime/src/libds/dsc/schema_logical.pb-c.h
        runtime/src/libds/dsc/schema_source.pb-c.h runtime/src/libds/dsc/schema_ttl.pb-c.h
        runtime/src/libds/dsc/slot.pb-c.h
        runtime/src/libds/dsc/alfa.pb-c.h runtime/src/libds/dsc/beta.pb-c.h
        runtime/src/libds/dsc/term.pb-c.h runtime/src/libds/dsc/rete_expr.pb-c.h
        runtime/src/libds/dsc/builtin_fn.pb-c.h runtime/src/libds/dsc/capabilities.pb-c.h

extend test_rfcs_record
  reads runtime/src/libds/dsc/common.pb-c.h runtime/src/libds/dsc/schema_def.pb-c.h
        runtime/src/libds/dsc/slot.pb-c.h

extend test_rfcs_slot_kinds
  reads runtime/src/libds/dsc/slot.pb-c.h

extend test_rfcs_announced_body
  reads runtime/src/libds/dsc/slot.pb-c.h

# test_assert_external unpacks a FactExternal, which imports slot.
extend test_assert_external
  reads runtime/src/libds/dsc/slot.pb-c.h runtime/src/libds/rfcs/fact_external.pb-c.h

# It also builds a `.dsc` by hand, as test_dsc_basic does, and asks the linked
# libds for the version to stamp it with.
extend test_assert_external
  reads runtime/tests/libds/impl/test_ds_version.h
        runtime/src/libds/dsc/header.pb-c.h runtime/src/libds/dsc/capabilities.pb-c.h
        runtime/src/libds/dsc/schema_logical.pb-c.h

# The generated headers test_rfcs_reader includes; ds_source imports common.
extend test_rfcs_reader
  reads runtime/src/libds/dsc/common.pb-c.h runtime/src/libds/dsc/ds_source.pb-c.h
        runtime/src/libds/dsc/schema_logical.pb-c.h runtime/src/libds/dsc/schema_ttl.pb-c.h
        runtime/src/libds/dsc/capabilities.pb-c.h runtime/src/libds/reader/dialect.pb-c.h
        runtime/src/libds/reader/pump_boundary.pb-c.h

# Run each test as a pass/fail check; the stamp materializes on exit 0.
# -D runner wraps the run, a run-time lane independent of the build-time
# cflags_extra. The test binary's key has no runner, so lanes share the
# compiled tests. The plain and wrapped runs are mutually exclusive on
# -D runner; the wrapped lane runs the vg "yes" tests.
#
# `tool` is the test binary, not the wrapper: the runner is already in the
# command, which the step key folds, and a -D command line is not a program to
# resolve.
#
# The suite stamp gates on every run stamp of the lane, except the Re2Test
# rows on a build without RE2: under `-D re2=stub` (the MSan lane) no pattern
# compiles, so a test of what RE2 accepts can only fail there. They run when
# the build links RE2.
each ImplTest t unless runner unless leak_lane
  with no Re2Test x where x.name == t.name
  step {t.name}.stamp
    cwd   runtime/tests/libds/impl
    stamp
    tool  runtime/tests/libds/impl/{t.name}
    run   ./{t.name}
    reads runtime/tests/libds/impl/{t.name}
  extend build_libds_tests.stamp
    reads {t.name}.stamp

each ImplTest t unless runner unless leak_lane
  with Re2Test x where x.name == t.name
  with Cfg r2 where r2.val == "re2"
  step {t.name}.stamp
    cwd   runtime/tests/libds/impl
    stamp
    tool  runtime/tests/libds/impl/{t.name}
    run   ./{t.name}
    reads runtime/tests/libds/impl/{t.name}
  extend build_libds_tests.stamp
    reads {t.name}.stamp

table Re2Test
  """An impl test wholly about RE2's own behaviour (what it accepts, matches or captures), so it can pass only on a build that links RE2. Under `-D re2=stub` it is not run, and the suite does not wait on it. Keyed by test name."""
  name
  test_re2_alloc_failure
  test_re2_group_names
  test_re2_surface

each ImplTest t when runner unless leak_lane where t.vg == "yes"
  step {t.name}.stamp
    cwd   runtime/tests/libds/impl
    stamp
    tool  runtime/tests/libds/impl/{t.name}
    run   {runner} ./{t.name}
    reads runtime/tests/libds/impl/{t.name}
  extend build_libds_tests.stamp
    reads {t.name}.stamp

# valgrind-leak lane — the leak "yes" subset under a full leak check; any
# unfreed byte fails. The caller supplies the runner:
#   build libds.build -D leak_lane=1 \
#       -D runner="valgrind --leak-check=full --errors-for-leak-kinds=all --error-exitcode=99 -q"
each ImplTest t when runner when leak_lane where t.leak == "yes"
  step {t.name}.stamp
    cwd   runtime/tests/libds/impl
    stamp
    tool  runtime/tests/libds/impl/{t.name}
    run   {runner} ./{t.name}
    reads runtime/tests/libds/impl/{t.name}

# asan/LSan lane — the same subset, no valgrind runner; the tests are built
# with -D cflags_extra="-fsanitize=address -fno-omit-frame-pointer" and run
# under ASAN_OPTIONS via `env`:
#   build libds.build -D leak_lane=1 -D cflags_extra="-fsanitize=address -fno-omit-frame-pointer"
each ImplTest t unless runner when leak_lane where t.leak == "yes"
  step {t.name}.stamp
    cwd   runtime/tests/libds/impl
    stamp
    tool  runtime/tests/libds/impl/{t.name}
    run   env ASAN_OPTIONS=detect_leaks=1:abort_on_error=1 ./{t.name}
    reads runtime/tests/libds/impl/{t.name}

# fan-in for both leak lanes (valgrind-leak and asan): the suite gates on the
# leak "yes" subset only, so in a leak lane build-unit builds only those tests.
each ImplTest t when leak_lane where t.leak == "yes"
  extend build_libds_tests.stamp
    reads {t.name}.stamp

step build_libds_tests.stamp
  stamp
  run true

# ══ section: spec ════════════════════════════════════════════════════════════
# The libds spec-conformance suite. Each test includes only the public libds.h
# and runs as a check step. From the repository root:
#
#   build libds.build build_libds_spec.stamp                                  # every spec test
#   build libds.build build_libds_spec.stamp -D cflags_extra=-fsanitize=address
#
# Enumerated, as the impl suite is. Safe to run wide: every step writes one
# file nothing else writes, libds.a is read-only to all of them, and
# spec_common.h's spec_load_ds writes its source and artefact under
# DS_MERCURY_SCRATCH, each mkstemp-unique.

table SpecTest
  name
  test_alloc_spec
  test_arch_invariants_spec
  test_cache_spec
  test_call_spec
  test_emit_spec
  test_errors_spec
  test_fact_identity_spec
  test_introspection_spec
  test_iret_9_6__null_leaf_is_a_type_error
  test_json_api_spec
  test_ldet_spec
  test_lerr_1_4_7__engine_error_stops_the_pump
  test_lfac_spec
  test_lfst_spec
  test_llog_spec
  test_log_spec
  test_ncbk_10_4__ill_formed_text_is_a_parse_refusal
  test_ncbk_2_6__timer_armed_is_the_rule_level_cooldowns_alone
  test_ncbk_2_9__a_read_after_the_halt_is_refused
  test_ncbk_2_9__latching_call_returns_engine_halted
  test_ncbk_7_2__abi_version_2_is_refused
  test_nfct_2_10__null_ts_refused
  test_nfct_2_3__a_reference_of_another_schema_is_a_mismatch
  test_nfct_6_3__lowering_facts_unseen
  test_nlfc_10_2__admission_after_load_is_refused
  test_nlfc_6_4__free_fires_no_callback
  test_nstg_2_3__set_cb_receives_the_write
  test_ntst_3_1__an_advance_past_a_clocks_range_is_refused
  test_null_spec
  test_publish_spec
  test_schema_registry_spec
  test_slot_kinds_spec
  test_stream_seq_spec
  test_ttl_spec

each SpecTest t
  # Public surface only: -I../../../include and no internal -I, so the spec
  # suite cannot see implementation headers.
  step {t.name}
    cwd   runtime/tests/libds/spec
    run   {cc} -O0 -g -Wall -Wextra -Wno-unused-parameter -std=c99 -ffp-contract=off -D_POSIX_C_SOURCE=200809L
          -I../../../include {cflags_extra} -o {t.name} {t.name}.c ../../../src/libds/libds.a
          -lprotobuf-c -lre2 -lstdc++ -lpthread -lm
    # The suite's own headers too: a test includes them, so an edit to one
    # must re-key every test that does.
    reads runtime/tests/libds/spec/{t.name}.c runtime/tests/libds/spec/spec_common.h
          runtime/tests/libds/spec/spec_tamper.h runtime/src/libds/libds.a
    makes runtime/tests/libds/spec/{t.name}

  # A plain run only: the spec suite has no valgrind lane. asan through
  # -D cflags_extra still applies, at build time.
  step {t.name}.stamp
    cwd   runtime/tests/libds/spec
    stamp
    tool  runtime/tests/libds/spec/{t.name}
    run   ./{t.name}
    reads runtime/tests/libds/spec/{t.name}

  extend build_libds_spec.stamp
    reads {t.name}.stamp

step build_libds_spec.stamp
  stamp
  run true

# ══ section: alloc_conformance ═══════════════════════════════════════════════
# The [IALC.10] allocator-override conformance. Each variant is gated on its
# own -D selector, so one invocation emits only that variant's steps (weak and
# macro need different libds.a builds). From the repository root:
#
#   build libds.build alloc_transparency.stamp -D transparency=1   # IALC.10.3 macro==raw .text (no libds)
#
#   # weak — over the default libds.a, which is mode-2/weak:
#   build libds.build alloc_weak.stamp -D weak=1
#
#   # macro — over a DS_ALLOC_HEADER libds.a, built in the same invocation:
#   build libds.build alloc_macro.stamp -D macro=1 \
#       -D alloc_header=../../tests/libds/alloc_conformance/ds_probe_macros.h

# ── transparency (standalone; needs no libds) — gated on -D transparency ──────
step alloc_transparency.stamp when transparency
  cwd   runtime/tests/libds/alloc_conformance
  stamp
  run   python3 ../../../../scripts/libds/transparency_check.py
  reads runtime/tests/libds/alloc_conformance/transparency_probe.c scripts/libds/transparency_check.py

# ── weak: strong ds_* (ds_override_weak.c) over the default (mode-2) libds.a ──
step conf_weak when weak
  cwd   runtime/tests/libds/alloc_conformance
  run   {cc} -O0 -g -Wall -Wextra -Wno-unused-parameter -std=c99 -ffp-contract=off -D_POSIX_C_SOURCE=200809L
        -I../../../include -I. -o conf_weak conformance_main.c alloc_probe.c ds_override_weak.c
        ../../../src/libds/libds.a -l:libprotobuf-c.so.1 -lre2 -lstdc++ -lpthread -lm
  reads runtime/tests/libds/alloc_conformance/conformance_main.c runtime/tests/libds/alloc_conformance/alloc_probe.c runtime/tests/libds/alloc_conformance/alloc_probe.h runtime/tests/libds/alloc_conformance/ds_override_weak.c runtime/src/libds/libds.a
  makes runtime/tests/libds/alloc_conformance/conf_weak

step alloc_weak.stamp when weak
  cwd   runtime/tests/libds/alloc_conformance
  stamp
  run   python3 ../../../../scripts/libds/run_conf.py conf_weak
  reads runtime/tests/libds/alloc_conformance/conf_weak scripts/libds/run_conf.py

# ── macro: DS_ALLOC_HEADER libds.a bakes probe_* in — no ds_* shim linked ─────
# RDSC_9_8_SITED: this leg's requests name their sites (ds_probe_macros.h), so
# rdsc-9-8-oom judges its absorbable-site table here and fails if none does.
step conf_macro when macro
  cwd   runtime/tests/libds/alloc_conformance
  run   {cc} -O0 -g -Wall -Wextra -Wno-unused-parameter -std=c99 -ffp-contract=off -D_POSIX_C_SOURCE=200809L
        -DRDSC_9_8_SITED=1 -I../../../include -I. -o conf_macro conformance_main.c alloc_probe.c
        ../../../src/libds/libds.a -l:libprotobuf-c.so.1 -lre2 -lstdc++ -lpthread -lm
  reads runtime/tests/libds/alloc_conformance/conformance_main.c runtime/tests/libds/alloc_conformance/alloc_probe.c runtime/tests/libds/alloc_conformance/alloc_probe.h runtime/src/libds/libds.a
  makes runtime/tests/libds/alloc_conformance/conf_macro

step alloc_macro.stamp when macro
  cwd   runtime/tests/libds/alloc_conformance
  stamp
  run   python3 ../../../../scripts/libds/run_conf.py conf_macro
  reads runtime/tests/libds/alloc_conformance/conf_macro scripts/libds/run_conf.py
