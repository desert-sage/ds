-- The DS formal-methods Idris package.
--
-- TWO JOBS, and the second is why this file exists at all. `idris2 --check`
-- typechecks a module and stops; it never generates code, so a decoder that
-- typechecks has still never DECODED anything. Building an executable does two
-- things `--check` cannot:
--
--   1. It compiles through Chez, which catches what elaboration defers.
--   2. It gives the worked examples somewhere to live. `Protobuf/Wire.idr`
--      records why they cannot be compile-time `Refl` proofs -- `div` and `mod`
--      on `Nat` do not reduce during elaboration, and rewriting the arithmetic
--      so they would makes the decoder worse. A property that needs a specific
--      input to be true is a test, and this is where tests run.
--
-- `Main` is the runner and is DELIBERATELY NOT a model module: it carries no
-- `--@spec` tags and is exempted from the clause-tie scanners by name, because
-- Idris fixes the entry point's name as `main` and no clause owns it; the
-- crossref's exempt list names it.

package ds-formal

version = 0.1.0
sourcedir = "."

main = Main
executable = "ds-formal-tests"

modules = Main
        , Protobuf.Framing
        , Protobuf.Message
        , Rete.Expr
        , Rete.FireClock
        , Rete.RateGate
        , Rete.ActivationKey
        , Lcdb.RuleGlobal
        , AbsentTrichotomy
        , Protobuf.Wire
        , AbsentValue
        , CapBreach
        , ClockStep
        , ConsumptionLoop
        , CrU128Mul
        , FixedRound
        , InertSlots
        , InertForms
        , RecordOrder
        , Replay
        , SeqAssignment
        , TsIdentity
        , TwoClocks
        , MockClock
        , CheckpointClocks
        , EventTime
        , Rete.EntryStamp
        , SeriesWindow
        , Rete.FireLoop
        , Rete.RunFold
        , Rete.Refcount
        , Rete.FireLoopTms
        , Lcyc.TmsWitnesses
        , Rete.TmsBridge
        , Rete.TmsRun
        , Lcyc.TmsTermination
        , Rete.PumpBoundary
        , Rete.RecomputeDiff
