-- The DS formal-methods Idris package.
--
-- TWO JOBS, and the second is why this file exists at all. `idris2 --check`
-- typechecks a module and stops; it never generates code, so an evaluator that
-- typechecks has still never EVALUATED anything. Building an executable does two
-- things `--check` cannot:
--
--   1. It compiles through Chez, which catches what elaboration defers.
--   2. It gives the worked examples somewhere to live: Integer and Double
--      arithmetic do not reduce during elaboration, so a property that needs a
--      specific input to be true is a test, and this is where tests run.
--
-- `Main` is the runner and is DELIBERATELY NOT a model module: it carries no
-- `--@spec` tags and is exempted from the clause-tie scanners by name, because
-- Idris fixes the entry point's name as `main` and no clause owns it; the
-- crossref's exempt list names it.

package ds-formal

version = 0.1.0
sourcedir = "."

main = Main
executable = "ds-formal-tests"

modules = Main
        , Rete.RateGate
        , Rete.ActivationKey
        , AbsentTrichotomy
        , FixedRound
        , TwoClocks
        , Rete.EntryStamp
        , Rete.FireLoop
        , Rete.RunFold
        , Rete.Refcount
        , Rete.FireLoopTms
        , Lcyc.TmsWitnesses
        , Rete.TmsBridge
        , Rete.TmsRun
        , Lcyc.TmsTermination
        , Rete.PumpBoundary
        , Rete.TmsRanked
        , Rete.RecomputeDiff
        , Rete.RecomputeFire
        , Rete.RecomputeStrata
        , Rete.TtlSweep
        , Rete.Network
        , Rete.NetworkView
        , Rete.NetworkPaths
        , Rete.NetworkDispatch
        , Rete.NetworkOrder
        , Rete.NetworkOrderKeep
        , Rete.NetworkRefraction
        , Rete.NetworkCorollaries
        , Rete.NetworkAgree
        , Rete.NetworkTransferOrder
        , Rete.NetworkTransferTable
        , Rete.NetworkTransferFlags
        , Rete.NetworkTransferAgree
        , Rete.NetworkTransfer
        , Rete.NetworkTmsCascade
        , Rete.NetworkTms
        , Rete.NetworkTmsTransfer
        , Rete.NetworkTtl
        , Rete.NetworkTraced
        , Rete.Eval
        , Rete.NetworkTick
        , Rete.NetworkClocked
        , Rete.NetworkEdges
        , Rete.NetworkTwoClocks
        , Rete.NetworkCooldown
        , Rete.NetworkTimed
        , Rete.NetworkWall
        , Rete.NetworkTimer
        , Rete.NetworkCall
        , Fixture
        , Lcyc.Lemmas
        , Lcyc.Propagation
        , Lcyc.Certificate
        , Lcyc.Termination
        , Lcyc.Witnesses
        , Lcyc.WitnessProofs
        , Lcyc.CertifiedWitness
