//
// must_fail_violation -- the refuted program with a DOCTORED input: Refuted
// names 7, which the program derives, so Violation is {7}. The expectation
// still claims Violation is empty and opens with MUST_FAIL, so
// the souffle check (private) passes this test only when the comparison FAILS. This
// is the `never emitted` shape caught in the act: a refuted tuple that IS
// derived must be reported, not absorbed ([STYL.5.10.5]).
//
//@derives [LLOG.1.2] [STYL.5.10.5]
#include "prelude.dl"

.decl Base(x: DsInt)
.decl Derived(x: DsInt)
.decl Refuted(x: DsInt)
.decl Violation(x: DsInt)
.input Base(filename="must_fail_violation.Base.facts")
.input Refuted(filename="must_fail_violation.Refuted.facts")

Derived(x) :- Base(x), x > 5.
Violation(x) :- Refuted(x), Derived(x).

.output Derived
.output Violation
