# calendar — the standard library's calendar module (LIMP.3.3.4)
#
# `calendar` declares nothing in source. It carries the builtin functions
# LEXP.17.2 lists under its name, reached only through an import of it:
# `time` (3, 6 or 7 Int fields, a UTC Time) and `date` (3 Int fields, a Date),
# both defined by LTIM.14.
#
#     import calendar                       # then calendar.time(2026, 1, 1)
#     from calendar import time, date       # then time(2026, 1, 1)
