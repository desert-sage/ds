# units.avoirdupois — avoirdupois mass system
#
# mass is a baked units.core base axis (ambient via the implicit preload,
# [LUNI.4.1.2]); no si import needed.
#
# Used across US and UK for general commerce and everyday mass measurement.
# All values in the mass dimension (base: kilogram).
#
# Note: grain has the same value in units.troy (64.79891 mg). Importing both
# modules produces a shadowing warning; both resolve to the same quantity.

unit grain:                mass  = x * 64.79891e-6         label "gr"
unit dram:                 mass  = x * 1.7718451953125e-3   label "dr"
unit ounce:                mass  = x * 28.349523125e-3      label "oz"  alias oz
unit pound:                mass  = x * 453.59237e-3         label "lb"  alias lb
unit short_hundredweight:  mass  = x * 45.359237           label "cwt"
unit long_hundredweight:   mass  = x * 50.80234544         label "cwt_uk"
unit short_ton:            mass  = x * 907.18474           label "tn"
unit long_ton:             mass  = x * 1016.0469088        label "tn_uk"
