# units.metric — non-SI units accepted for use with the SI (BIPM 9th ed, Table 8)
# plus universally-used metric-adjacent units.
#
from units.si import volume, area, pressure, energy, power
# mass / length are baked units.core base axes (ambient via the implicit
# preload, [LUNI.4.1.2]); no si import needed.

# ── Volume ────────────────────────────────────────────────────────────────────
# 1 litre = 1 dm³ = 0.001 m³ (exact)

unit litre:       volume  = x / 1000             label "L"    alias L, l
unit decilitre:   volume  = x / 10_000           label "dL"   alias dL
unit centilitre:  volume  = x / 100_000          label "cL"   alias cL
unit millilitre:  volume  = x / 1_000_000        label "mL"   alias mL
unit microlitre:  volume  = x / 1_000_000_000    label "µL"   alias µL, uL

# ── Mass ──────────────────────────────────────────────────────────────────────
# tonne = megagram (1000 kg). SI calls it "tonne" not "metric ton".

unit tonne:       mass    = x * 1000             label "t"    alias t
unit kilotonne:   mass    = x * 1_000_000        label "kt"   alias kt
unit megatonne:   mass    = x * 1_000_000_000    label "Mt"   alias Mt

# ── Area ──────────────────────────────────────────────────────────────────────
# 1 hectare = 10,000 m² (exact)

unit hectare:     area    = x * 10_000           label "ha"   alias ha
unit are:         area    = x * 100              label "a"

# ── Pressure ──────────────────────────────────────────────────────────────────

unit bar:         pressure  = x * 100_000        label "bar"
unit millibar:    pressure  = x * 100            label "mbar" alias mbar
unit microbar:    pressure  = x / 10             label "µbar" alias µbar, ubar

# ── Length ────────────────────────────────────────────────────────────────────

unit angstrom:          length  = x / 10_000_000_000    label "Å"   alias Å
unit astronomical_unit: length  = x * 149_597_870_700   label "au"  alias au

# ── Energy ────────────────────────────────────────────────────────────────────
# electronvolt: exact by 2019 SI redefinition (1.602176634×10⁻¹⁹ J)
# kilocalorie: IT value (4186.8 J)

unit electronvolt:     energy  = x * 1.602176634e-19   label "eV"   alias eV
unit kiloelectronvolt: energy  = x * 1.602176634e-16   label "keV"  alias keV
unit megaelectronvolt: energy  = x * 1.602176634e-13   label "MeV"  alias MeV
unit gigaelectronvolt: energy  = x * 1.602176634e-10   label "GeV"  alias GeV
unit teraelectronvolt: energy  = x * 1.602176634e-7    label "TeV"  alias TeV

unit kilocalorie:      energy  = x * 4186.8            label "kcal" alias kcal
unit calorie:          energy  = x * 4.1868            label "cal"  alias cal

# ── Mass ──────────────────────────────────────────────────────────────────────
# dalton (unified atomic mass unit): CODATA 2018 value

unit dalton:      mass    = x * 1.66053906660e-27  label "Da"  alias Da, u

# ── Power ─────────────────────────────────────────────────────────────────────
# metric horsepower (Pferdestärke): exact value 735.49875 W

unit metric_horsepower: power  = x * 735.49875     label "PS"  alias PS
