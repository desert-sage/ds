# units.electrical — electromagnetic units beyond SI
#
# The SI-named electrical units (ohm, farad, henry, siemens, coulomb, weber,
# tesla) with all their prefixed forms are declared in units.si. This module
# adds non-SI electromagnetic units and electrical horsepower.
#
from units.si import magnetic_flux, magnetic_flux_density, power

# ── CGS electromagnetic units ─────────────────────────────────────────────────
# Gauss and maxwell remain common in sensor datasheets and legacy literature.

unit gauss:   magnetic_flux_density  = x * 1e-4    label "G"    alias G
unit maxwell: magnetic_flux          = x * 1e-8    label "Mx"   alias Mx

# ── Power ─────────────────────────────────────────────────────────────────────
# Electrical horsepower: exactly 746 W (IEEE Std 100).
# Distinct from mechanical hp (units.customary) and metric hp/PS (units.metric).

unit electrical_horsepower: power  = x * 746       label "hp(E)"
