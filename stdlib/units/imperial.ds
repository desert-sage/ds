# units.imperial — UK imperial units
#
from units.si import volume
# mass is a baked units.core base axis (ambient via the implicit preload).
#
# Length is NOT duplicated here. UK uses the same inch/foot/yard/mile as US
# customary (identical since the International Yard and Pound Agreement, 1959).
# Import units.customary for length.

# ── Mass ──────────────────────────────────────────────────────────────────────

unit stone:               mass  = x * 6.35029318         label "st"
unit long_hundredweight:  mass  = x * 50.80234544        label "cwt"
unit long_ton:            mass  = x * 1016.0469088       label "ton"

# ── Volume ────────────────────────────────────────────────────────────────────
# UK imperial fluid measure — distinct values from US customary.

unit imperial_fluid_ounce: volume  = x * 28.4130625e-6   label "fl oz"
unit imperial_pint:        volume  = x * 568.26125e-6    label "pt"
unit imperial_quart:       volume  = x * 1136.5225e-6    label "qt"
unit imperial_gallon:      volume  = x * 4546.09e-6      label "gal"
