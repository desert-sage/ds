# units.troy — troy mass system
#
# mass is a baked units.core base axis (ambient via the implicit preload,
# [LUNI.4.1.2]); no si import needed.
#
# Used for precious metals (gold, silver, platinum) and gemstones.
# All values in the mass dimension (base: kilogram).
#
# Note: grain has the same value in units.avoirdupois (64.79891 mg).

unit grain:        mass  = x * 64.79891e-6       label "gr"
unit pennyweight:  mass  = x * 1.55517384e-3     label "dwt"
unit troy_ounce:   mass  = x * 31.1034768e-3     label "oz t"
unit troy_pound:   mass  = x * 373.2417216e-3    label "lb t"
