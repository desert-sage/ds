# units.nautical — international nautical units
#
# All values are exact SI definitions.
from units.si import velocity
# length is a baked units.core base axis (ambient via the implicit preload).

unit nautical_mile:    length    = x * 1852                  label "nmi"  alias nmi
unit fathom:           length    = x * 1.8288                label "ftm"
unit cable:            length    = x * 185.2                 label "cbl"
unit nautical_league:  length    = x * 5556                  label "nleague"
unit knot:             velocity  = x * 1852 / 3600           label "kn"   alias kn
