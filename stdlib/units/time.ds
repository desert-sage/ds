# units.time — time dimension extension beyond SI
#
# time is a baked units.core base axis (ambient via the implicit preload,
# [LUNI.4.1.2]); no si import needed. All values are int64 nanoseconds.

unit week:           time  = x * 604_800_000_000_000       label "wk"   alias wk
unit fortnight:      time  = x * 1_209_600_000_000_000     label "fn"
unit year_julian:    time  = x * 31_557_600_000_000_000    label "yr"
unit year_gregorian: time  = x * 31_556_952_000_000_000    label "yr_g"
unit year_tropical:  time  = x * 31_556_925_974_880_000    label "yr_t"
# year_tropical: 365.24219878 days (Meeus, Astronomical Algorithms 2nd ed, ch. 27).
