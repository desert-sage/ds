# math — the standard library's mathematics module (LIMP.3.3.4)
#
# Besides the three constants below, `math` carries the builtin functions
# LEXP.17.2 lists under its name, reached only through an import of it:
# `floor` `ceil` `trunc` `sign`, `fma`, `sqrt` `exp` `ln` `log2` `log10` `pow`,
# `sin` `cos` `tan` `asin` `acos` `atan` `atan2`, `sinh` `cosh` `tanh`, and
# `degrees` `radians`.
#
#     import math                  # then math.sin(x), math.pi
#     from math import sin, pi     # then sin(x), pi
#
# Each constant is the binary64 nearest its value (LIMP.3.3.4's table).

const pi = 3.141592653589793
const e = 2.718281828459045
const tau = 6.283185307179586
