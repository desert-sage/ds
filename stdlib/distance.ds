# distance — the standard library's distance module (LIMP.3.3.4)
#
# `distance` declares nothing in source. It carries the builtin functions
# LEXP.17.2 lists under its name, reached only through an import of it:
# `euclidean` `manhattan` `chebyshev` `hypotenuse` `cosine` (2D and 3D
# arities) and `great_circle` (LEXP.5.11).
#
#     import distance                        # then distance.euclidean(...)
#     from distance import great_circle      # then great_circle(...)
