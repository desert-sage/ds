(* ds_json_kind — an enumeration registry ([STYL.2.15.6]).

   The kind of a Json node an integrator reads through libds's accessor API.
   libds's `ds_json_kind_t` mirrors it name for name and value for value. It
   travels nowhere, so it is an EBNF registry rather than a protobuf
   ([STYL.5.9.7]).

   The alternation below is the closure: these names and no others.
   Each production is an allocation. A production that is NOT a member
   of the alternation is out of use — the number stays allocated to that
   name ([STYL.2.8.7]). *)

ds_json_kind = DS_JSON_NULL
             | DS_JSON_BOOL
             | DS_JSON_INT
             | DS_JSON_FLOAT
             | DS_JSON_STRING
             | DS_JSON_ARRAY
             | DS_JSON_OBJECT ;

(* allocations *)

DS_JSON_NULL   = "0" ;
DS_JSON_BOOL   = "1" ;
DS_JSON_INT    = "2" ;
DS_JSON_FLOAT  = "3" ;
DS_JSON_STRING = "4" ;
DS_JSON_ARRAY  = "5" ;
DS_JSON_OBJECT = "6" ;
