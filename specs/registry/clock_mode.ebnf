(* ds_clock_mode — an enumeration registry ([STYL.2.15.6]).

   Whether an engine reads the platform's clocks or the integrator drives
   them. libds's `ds_clock_mode_t` mirrors it name for name and value for
   value. It travels nowhere, so it is an EBNF registry rather than a protobuf
   ([STYL.5.9.7]).

   The alternation below is the closure: these names and no others.
   Each production is an allocation. A production that is NOT a member
   of the alternation is out of use — the number stays allocated to that
   name ([STYL.2.8.7]). *)

ds_clock_mode = DS_CLOCK_LIVE
              | DS_CLOCK_MOCK ;

(* allocations *)

DS_CLOCK_LIVE = "0" ;
DS_CLOCK_MOCK = "1" ;
