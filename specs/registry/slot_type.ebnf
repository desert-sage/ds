(* ds_slot_type — an enumeration registry ([STYL.2.15.6]).

   The type an integrator declares for a slot when it registers a schema.
   libds's `ds_slot_type_t` mirrors it name for name and value for value. It
   is not a mirror of `proto/slot.proto#SlotKind`, whose numbers differ; the
   loader maps one to the other. It travels nowhere, so it is an EBNF
   registry rather than a protobuf ([STYL.5.9.7]).

   The alternation below is the closure: these names and no others.
   Each production is an allocation. A production that is NOT a member
   of the alternation is out of use — the number stays allocated to that
   name ([STYL.2.8.7]). *)

ds_slot_type = DS_SLOT_TYPE_INT
             | DS_SLOT_TYPE_FLOAT
             | DS_SLOT_TYPE_STRING
             | DS_SLOT_TYPE_BOOL
             | DS_SLOT_TYPE_JSON
             | DS_SLOT_TYPE_SCHEMA
             | DS_SLOT_TYPE_BYTES
             | DS_SLOT_TYPE_TIME
             | DS_SLOT_TYPE_DATE
             | DS_SLOT_TYPE_DURATION ;

(* allocations *)

DS_SLOT_TYPE_INT      = "0" ;
DS_SLOT_TYPE_FLOAT    = "1" ;
DS_SLOT_TYPE_STRING   = "2" ;
DS_SLOT_TYPE_BOOL     = "3" ;
DS_SLOT_TYPE_JSON     = "4" ;
DS_SLOT_TYPE_SCHEMA   = "5" ;
DS_SLOT_TYPE_BYTES    = "6" ;
DS_SLOT_TYPE_TIME     = "7" ;
DS_SLOT_TYPE_DATE     = "8" ;
DS_SLOT_TYPE_DURATION = "9" ;
