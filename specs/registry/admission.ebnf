(* ds_admission — an enumeration registry ([STYL.2.15.6]).

   Which settings of one capability an integration admits. libds's
   `ds_admission_t` mirrors it name for name and value for value. It travels
   nowhere, so it is an EBNF registry rather than a protobuf ([STYL.5.9.7]).

   The alternation below is the closure: these names and no others.
   Each production is an allocation. A production that is NOT a member
   of the alternation is out of use — the number stays allocated to that
   name ([STYL.2.8.7]). *)

ds_admission = DS_ADMIT_EITHER
             | DS_ADMIT_TRUE_ONLY
             | DS_ADMIT_FALSE_ONLY ;

(* allocations *)

DS_ADMIT_EITHER     = "0" ;
DS_ADMIT_TRUE_ONLY  = "1" ;
DS_ADMIT_FALSE_ONLY = "2" ;
