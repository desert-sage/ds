(* ds_metric_kind — an enumeration registry ([STYL.2.15.6]).

   How a receiver folds a metric observation. libds's `ds_metric_kind_t`
   mirrors it name for name and value for value. It travels nowhere, so it is
   an EBNF registry rather than a protobuf ([STYL.5.9.7]). Its consumers are
   generated from it; never hand-write them ([STYL.5.9.6]).

   The alternation below is the closure: these names and no others.
   Each production is an allocation. A production that is NOT a member
   of the alternation is out of use — the number stays allocated to that
   name ([STYL.2.8.7]). *)

ds_metric_kind = DS_METRIC_COUNTER
               | DS_METRIC_GAUGE
               | DS_METRIC_HISTOGRAM ;

(* allocations *)

DS_METRIC_COUNTER   = "0" ;
DS_METRIC_GAUGE     = "1" ;
DS_METRIC_HISTOGRAM = "2" ;
