            },
            "y": {
                "rules_ds": "schema Trig scope logical:\n    v: Int key\n"
            }
        },
        "steps": [
            {
                "engine": "x",
                "op": "assert",
                "schema": "Trig",
                "slots": {
                    "v": 1
                },
                "as": "h"
            },
            {
                "engine": "y",
