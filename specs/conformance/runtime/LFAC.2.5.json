{
    "id": "LFAC.2.5",
    "clauses": ["LLOG.11.3"],
    "category": "runtime",
    "scenario": "Logical-lifecycle dedup per LFAC.2.5 \u2014 asserting two facts of the same schema with byte-identical slot values produces one fact in working memory, not two.",
    "rules_ds": "schema Trig scope logical:\n    v: Int key\n",
    "expect": {
        "kind": "runtime_fact_count",
        "asserts": [
            {
                "schema": "Trig",
                "slots": {
                    "v": 42
                }
            },
            {
                "schema": "Trig",
                "slots": {
                    "v": 42
                }
            }
        ],
        "pump": true,
        "fact_count_after": 1
    }
}
