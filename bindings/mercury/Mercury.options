#
# mmc's per-module options for mercury_ds, its test program, its harness, its
# driver of the binding differential and its driver of fuzz-dsc's scripts.
# Every module halts at a warning, so a warning is an error here and nowhere
# is one left standing (MERCURY_STYLE.md, "What the gate checks"). The
# runtime's modules, built beside these, are not this file's. scripts/mercury/check.py
# holds every module of the binding to a line here.

MCFLAGS-mercury_ds = --halt-at-warn
MCFLAGS-mercury_ds.atoms = --halt-at-warn
MCFLAGS-mercury_ds.error = --halt-at-warn
MCFLAGS-mercury_ds.events = --halt-at-warn
MCFLAGS-mercury_ds.from_runtime = --halt-at-warn
MCFLAGS-mercury_ds.host = --halt-at-warn
MCFLAGS-mercury_ds.introspect = --halt-at-warn
MCFLAGS-mercury_ds.session = --halt-at-warn
MCFLAGS-mercury_ds.status = --halt-at-warn
MCFLAGS-mercury_ds.value = --halt-at-warn
MCFLAGS-test_mercury_ds = --halt-at-warn
MCFLAGS-harness = --halt-at-warn
MCFLAGS-trace_mercury_ds = --halt-at-warn
MCFLAGS-host_values_mercury = --halt-at-warn
