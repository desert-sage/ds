#
# mercury_ds fixture: a series kept per key, read by the rule below. No
# public function reads one, and a pump hands the host no duty for it.

use default

schema Sensor scope logical:
    entity_id: String key
    state: Float mutable

series Sensor.state:
    count sliding 10_s

rule trig:
    Sensor t where count(t.state) > 0
->
    log info "x"
