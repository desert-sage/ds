#
# mercury_ds fixture: a schema with a reference to another, for what a host's
# reference must name ([NFCT.2.3]).

use default

schema Target scope logical:
    id: Int key

schema Holder scope logical:
    k: Int key
    t: Target mutable

rule seen:
    Holder h
->
    log info "holder {h.k}"
