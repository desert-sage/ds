//
// `tsc --checkJs`, strict, over lib/ (bindings/js/JS_STYLE.md JS.13). The
// js lane runs it (scripts/js/check.py's typecheck), with the pinned
// TypeScript and @types/node, and compares the declarations it writes with the
// committed types/, which ship with the package.
{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "noEmitOnError": true,
    "rootDir": "lib",
    "outDir": "types",
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["es2022", "esnext.disposable", "dom"],
    "types": ["node"],
    "skipLibCheck": true,
    "newLine": "lf"
  },
  "include": ["lib/*.js"]
}
