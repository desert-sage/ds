#
# The R8 fixture for the @ds-lang/ds suite (bindings/js/test). Compiled by the
# branch's own Mercury dsc in the `js` gate, never committed as a .dsc: a
# checked-in artefact stops loading at the next minor bump ([LDET.1.10]).
#
# A cooldown rule, so a firing arms a timer: `timer_armed` carries the arming
# firing's timetag, as `rule_lhs_facts` does ([NCBK.2.12]).

use default

schema Ping scope logical:
    id: Int key

schema Pong scope ttl 60_s:
    id: Int

rule echo cooldown 10_min:
    Ping p
->
    emit Pong id: p.id
