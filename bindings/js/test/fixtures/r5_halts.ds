#
# An engine error a test can reach on purpose, the program pyds's
# test_binding_contracts.py halts with: an artefact that lies. The rule does
# arithmetic on the Int slot `lied`; the test edits the compiled `.dsc` so the
# slot's Slot atom declares String (engine.test.mjs `lying`). The engine then
# holds a String where the compiled rule reads an Int, with no Json taint to
# explain it, so the fault is ARTEFACT_LIED, an EngineError, and an
# EngineError halts the engine. Every route through the language alone is a
# ComputationError instead, an unknown computed format among them.
#
# `Doc` gives a halted engine a Json slot to be handed text in ([NFCT.2.11],
# [LSTR.8.5]). No rule reads it.

use default

schema P scope logical:
    id: Int key
    lied: Int mutable

schema Doc scope logical:
    id: Int key
    doc: Json mutable

rule halt:
    P p where p.lied + 1 > 0
->
    log info "never"
