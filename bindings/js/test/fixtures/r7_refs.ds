#
# The R7 fixture for the @ds-lang/ds suite: a rule emits a fact holding fact
# references, one set and one nullable left empty, for the reader's decode by
# the stream's own announcement with each reference's recorded handle
# ([RFCS.6.3]). Compiled by the branch's own Mercury dsc in the `js` gate.

use default

schema Motion scope logical:
    entity_id: String key
    level: Float mutable

schema Trace scope ttl 1_h:
    target: Motion
    seen: Motion?
    n: Int

rule make_trace:
    Motion m where m.level > 0.5
->
    emit Trace target: m n: 1
