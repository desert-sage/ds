#
# A series, read by the rule below: no public function reads one. It
# needs the series backends, which ds_engine_new registers.

use default

schema Sensor scope logical:
    entity_id: String key
    state: Float mutable

series Sensor.state:
    count sliding 10_s

rule trig:
    Sensor t where count(t.state) > 0
->
    log info "x"
