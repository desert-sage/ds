#
# The `ts` fixture for the @ds-lang/ds suite: a logical schema's `ts` is a
# `Time` carrying no marker, and the compiler gives it the identity role ENGINE,
# outside the identity key and the no-op comparison (LFAC.9.1). `stale` reads
# it; any schema may declare `ts` (LFAC.9.1). Compiled by the branch's own
# Mercury dsc in the `js` gate, never committed as a .dsc.

use default

schema Reading scope logical:
    id: Int key
    v: Int mutable
    ts: Time

rule stale:
    Reading r where now() - r.ts > 5_min
->
    log info "stale"
