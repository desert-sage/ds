# [NLFC.2.5]'s three kinds of deadline: a cache entry at 10 s, a `Lease` fact at
# 20 s and an `after` timer at 30 s.

use default

schema Arm scope logical:
    id: Int key

schema Lease scope ttl 20_s:
    id: Int

schema Write scope logical:
    id: Int key

schema Drop scope logical:
    id: Int key

rule arm_timer:
    Arm
->
    after 30_s:
        log critical "fired"

rule write_cache:
    Write
->
    cache key: "k" value: 1 ttl: 10_s

rule drop_cache:
    Drop
->
    cache_delete key: "k"
