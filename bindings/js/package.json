{
  "name": "@ds-lang/ds",
  "version": "0.0.0+dev",
  "description": "The JavaScript binding to libds, the rule engine of Desert Sage (DS).",
  "license": "BSD-4-Clause OR AGPL-3.0-or-later",
  "homepage": "https://ds-lang.org",
  "repository": { "type": "git", "url": "git+https://github.com/desert-sage/ds.git", "directory": "bindings/js" },
  "bugs": { "url": "https://github.com/desert-sage/ds/issues" },
  "type": "module",
  "main": "lib/index.js",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "browser": { "types": "./types/browser.d.ts", "default": "./lib/browser.js" },
      "types": "./types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./browser": { "types": "./types/browser.d.ts", "default": "./lib/browser.js" },
    "./status": { "types": "./types/status.d.ts", "default": "./lib/status.js" }
  },
  "files": ["lib/", "src/", "types/"],
  "engines": { "node": ">=20" },
  "private": true
}
