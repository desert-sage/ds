{
  "name": "@ds-lang/ds",
  "version": "0.0.0+dev",
  "description": "The JavaScript binding to libds, the Desert Sage (DS) rule engine — native (Node-API) and wasm from one glue.",
  "license": "BSD-4-Clause OR AGPL-3.0-or-later",
  "type": "module",
  "main": "lib/index.js",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "browser": { "types": "./types/browser.d.ts", "default": "./lib/browser.js" },
      "types": "./types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./browser": { "types": "./types/browser.d.ts", "default": "./lib/browser.js" },
    "./status": { "types": "./types/status.d.ts", "default": "./lib/status.js" }
  },
  "files": ["lib/", "src/", "types/"],
  "engines": { "node": ">=20" },
  "private": true
}
