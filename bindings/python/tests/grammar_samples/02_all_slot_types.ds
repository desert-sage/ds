schema Sample scope logical:
    """schema covering every primitive slot type"""
    i: Int key
    f: Float mutable
    s: String mutable
    b: Bool mutable
    j: Json mutable
    t: Int mutable tolerance 0

schema Reading scope logical:
    state: Float mutable tolerance 0.5 "tolerance accepts comparable noise on a Float slot"
