# The spec book's pages are generated by scripts/spec/spec_book.py and never
# committed: the clause pages from specs/**.json (STYL.5.6.2), the proto pages
# from proto/*.proto (STYL.5.6.4). Only each tree's README.md is committed.
/language/*.md
/runtime/*.md
/impl/*.md
/integration/*.md
!/*/README.md
/proto/
