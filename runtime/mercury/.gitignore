# The `mem` configuration and database. Local session state, not project
# content: `.mem.ini` says where this checkout's store is, and a handoff is
# deleted the moment it is read.
.mem.ini
.mem.db
.mem.db.lock

# Mercury build output. The build runs in a container with its own tree, so these
# should never appear here -- but they do if anyone runs mmc in this directory.
Mercury/
*.err
*.mh
libds.a
libds.so

# Python bytecode: importing the tools beside the source leaves __pycache__ trees.
__pycache__/
*.py[cod]
