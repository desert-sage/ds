# Two facts per schema with different tags, a pump apart: `Keyed` holds two,
# `NoKey`'s one empty identity supersedes, and `Plain` accumulates.
assert Plain tag=a v=1
assert NoKey tag=a v=1
assert Keyed tag=a v=1
pump
advance 10000000000
assert Plain tag=b v=2
assert NoKey tag=b v=2
assert Keyed tag=b v=2
pump
