# Float `min` and `max` over both zeros on all_time, sliding and sample -- see
# fixtures/156_series_minmax_zeros.ds. Identities `a` and `b` on each schema:
#
#   pump 1  cold: -9.0, -9.0
#   pump 2  a [0.0]: 0.0, 0.0;  b [-0.0]: -0.0, -0.0
#   pump 3  a [0.0, 1.0]: 0.0, 1.0;  b [-0.0, -1.0]: -1.0, -0.0
#   pump 4  a [0.0, 1.0, -0.0]: -0.0, 1.0;  b [-0.0, -1.0, 0.0]: -1.0, 0.0
#   pump 5  a [0.0, 1.0, -0.0, -1.0]: -1.0, 1.0
#
# Every assert changes its value, so each is a sample ([LFAC.2.5.1]).
# @spec [LSER.17.2] [LSER.16.2] [LSER.19.8]
assert EA k=a v=0.0
assert EA k=b v=-0.0
assert EW k=a v=0.0
assert EW k=b v=-0.0
assert ES k=a v=0.0
assert ES k=b v=-0.0
pump
assert EA k=a v=1.0
assert EA k=b v=-1.0
assert EW k=a v=1.0
assert EW k=b v=-1.0
assert ES k=a v=1.0
assert ES k=b v=-1.0
pump
assert EA k=a v=-0.0
assert EA k=b v=0.0
assert EW k=a v=-0.0
assert EW k=b v=0.0
assert ES k=a v=-0.0
assert ES k=b v=0.0
pump
assert EA k=a v=-1.0
assert EA k=b v=2.0
assert EW k=a v=-1.0
assert EW k=b v=2.0
assert ES k=a v=-1.0
assert ES k=b v=2.0
pump
assert EA k=a v=2.0
assert EW k=a v=2.0
assert ES k=a v=2.0
pump
