assert Reading entity_id=r1 zone=a state=35.0
pump
assert Reading entity_id=r1 zone=a state=36.0
pump
assert Reading entity_id=r1 zone=a state=37.0
pump
assert Reading entity_id=r1 zone=a state=38.0
pump
