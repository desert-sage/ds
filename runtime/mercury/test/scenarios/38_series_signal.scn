# The two time-weighted aggregations over an uneven clock (1, 3, then 1
# minute), where a time-weighted answer and a sample proportion differ.
# `Pump.running` is true, false, true; `Flow.lpm` carries 0, 60, 0.
assert Pump entity_id=p running=true
assert Flow entity_id=f lpm=0.0
pump
advance 60000000000
assert Pump entity_id=p running=false
assert Flow entity_id=f lpm=60.0
pump
advance 180000000000
assert Pump entity_id=p running=true
assert Flow entity_id=f lpm=0.0
pump
advance 60000000000
# A fourth Flow sample closes the 60 lpm interval, 60s..240s: 10800
# value-seconds.
assert Flow entity_id=f lpm=0.0
pump
