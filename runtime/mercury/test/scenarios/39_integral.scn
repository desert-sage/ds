# Changing values (a no-op reassert is no sample), sixty seconds apart, into
# the four `integral` variants. The closed intervals give 10*60 + 20*60 +
# 30*60 + 40*60 = 6000 value-seconds by the last read. The 10-minute window is
# never full in the 5-minute run.
assert SlideHold entity_id=x v=10.0
assert SlideZero entity_id=x v=10.0
assert AllHold entity_id=x v=10.0
assert AllZero entity_id=x v=10.0
pump
advance 60000000000
assert SlideHold entity_id=x v=20.0
assert SlideZero entity_id=x v=20.0
assert AllHold entity_id=x v=20.0
assert AllZero entity_id=x v=20.0
pump
advance 60000000000
assert SlideHold entity_id=x v=30.0
assert SlideZero entity_id=x v=30.0
assert AllHold entity_id=x v=30.0
assert AllZero entity_id=x v=30.0
pump
advance 60000000000
assert SlideHold entity_id=x v=40.0
assert SlideZero entity_id=x v=40.0
assert AllHold entity_id=x v=40.0
assert AllZero entity_id=x v=40.0
pump
advance 60000000000
assert SlideHold entity_id=x v=50.0
assert SlideZero entity_id=x v=50.0
assert AllHold entity_id=x v=50.0
assert AllZero entity_id=x v=50.0
pump
