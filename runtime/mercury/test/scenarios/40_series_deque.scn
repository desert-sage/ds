# The FIFO deque. `Reading.level` ascends, so `first` and `last` differ;
# `Health.ok` alternates, so `bool_and` and `bool_or` read mixed windows. Every
# assert is a real change, since a no-op reassert is no sample.
# @spec [LSER.16.9] [LSER.16.8] [LSER.19.8]
assert Reading entity_id=r level=10.0
assert Health entity_id=h ok=true
pump
advance 60000000000
assert Reading entity_id=r level=20.0
assert Health entity_id=h ok=false
pump
advance 60000000000
assert Reading entity_id=r level=30.0
assert Health entity_id=h ok=true
pump
advance 60000000000
assert Reading entity_id=r level=40.0
assert Health entity_id=h ok=false
pump
advance 60000000000
assert Reading entity_id=r level=50.0
assert Health entity_id=h ok=true
pump
