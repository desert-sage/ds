# `withdraw` in an `after` body ([IRET.10.7], [LGRA.10.1.4]). `later` consumes
# its Go and arms a timer that withdraws the Job it matched and emits a Check.
# A twin Job asserted before the timer fires does not fire `later`, the Go
# being gone, so one "left 1" means the withdraw took the matched Job by
# identity. The Job is captured as a fact reference, so the withdraw lowers
# to ACTION_WITHDRAW_BY_ID, recorded as FactWithdraw AUTHOR_WITHDRAWN
# (cause 6).

schema Go scope explicit:
    n: Int

schema Job scope explicit:
    id: Int

schema Check scope explicit:
    v: Int

rule later:
    Go g
    Job j where j.id == g.n
->
    withdraw g
    after 5_s:
        log info "timer"
        withdraw j
        emit Check v: 1

rule left:
    Check c
    Job j where j.id == c.v
->
    log info "left {j.id}"
