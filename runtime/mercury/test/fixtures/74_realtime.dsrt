# The realtime contract for 74_realtime.ds ([RTCT.3.1]), with generous caps.
# `nodes:` is exhaustive: one alpha (the `Reading` pattern), one beta (the
# `where`), one terminal.
contract:
  wm_max:             1024
  agenda_cap:         256
  max_fires_per_pump: 64
  token_pool_cap:     512
  intern_cap:         256
  intern_bytes_cap:   65536
  cache_cap:          64
  cache_bytes_cap:    16384
  pump_wcet_ns:       10000000

  nodes:
    - node_id:  1
      kind:     alpha
      capacity: 256
    - node_id:  2
      kind:     beta
      capacity: 256
    - node_id:  3
      kind:     term
      capacity: 64
