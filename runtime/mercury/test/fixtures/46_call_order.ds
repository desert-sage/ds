service svc.put:
    kwarg zeta: String
    kwarg alpha: Int
    kwarg mid: Float
    no response

schema In scope logical:
    id: Int key

rule put:
    In i
->
    call svc.put mid: 1.5 zeta: "z" alpha: i.id nocooldown
