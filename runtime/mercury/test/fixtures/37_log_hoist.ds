schema Trig scope logical:
    v: Int key

schema Out scope ttl 1_h:
    v: Int

rule alert_then_log:
    Trig
->
    log critical "the alert"
    log info "after the alert"

rule cache_then_log:
    Trig
->
    cache key: "k" value: 1
    log info "after the cache set"

rule interleaved:
    Trig
->
    log critical "first"
    log info "second"
    emit Out v: 3
    log info "fourth"
