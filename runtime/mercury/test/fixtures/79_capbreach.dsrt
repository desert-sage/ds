# `wm_max: 2`, [RTCT.7]'s cap on simultaneous facts, is below the three facts
# its scenario asserts. Every other cap is generous.
contract:
  wm_max:             2
  agenda_cap:         256
  max_fires_per_pump: 64
  token_pool_cap:     512
  intern_cap:         256
  intern_bytes_cap:   65536
  cache_cap:          64
  cache_bytes_cap:    16384
  pump_wcet_ns:       10000000

  nodes:
    - node_id:  1
      kind:     alpha
      capacity: 256
    - node_id:  2
      kind:     beta
      capacity: 256
    - node_id:  3
      kind:     term
      capacity: 64
