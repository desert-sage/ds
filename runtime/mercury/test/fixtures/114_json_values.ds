service svc.j:
    kwarg data: Json
    no response

service svc.n:
    kwarg x: Float
    no response

schema P scope logical:
    id: Int key
    txt: String mutable

rule cache_absent:
    P p
->
    cache key: "n" value: p.txt::Float?
