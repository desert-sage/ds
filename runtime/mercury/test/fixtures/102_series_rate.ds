# Sliding `rate`, `(last - first) / elapsed_seconds` ([LSER.16.9]), over the
# two end samples: (10.0 @ t, 30.0 @ t+2s) is 10.0 per second. `-1.0` stands
# for `rate`'s null, outside every rate the scenario produces, so the two
# no-elapsed-time cases stay distinct from a measured flat 0.0.
use default


schema Flow scope logical:
    k: String key
    v: Float mutable

schema Rate scope ttl 1_h:
    label: String
    r: Float

series Flow.v (by: k):
    rate sliding 10_s

rule report:
    Flow f
->
    emit Rate label: f.k r: f.rate ?? -1.0
