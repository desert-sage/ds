# `minute` and `kelvin` are `units.core`'s, which every compile reads
# ([LUNI.4.1.2], [RCLI.1.11]); redeclaring them is [LIMP.5.1.5]'s refusal.
unit celsius: temperature = x + 273.15
unit half_celsius: temperature = x / 2 + 273.15

service timer.arm:
    kwarg wait: minute required
    no response

service hvac.set:
    kwarg t: celsius required
    kwarg h: half_celsius required
    no response

schema Delay scope logical:
    k: Int key
    wait: Duration mutable

schema Reading scope logical:
    k: Int key
    t: kelvin mutable

rule arm:
    Delay d
->
    call timer.arm wait: d.wait nocooldown
    log info "armed {d.k}"

rule set:
    Reading r
->
    call hvac.set t: r.t h: r.t nocooldown
