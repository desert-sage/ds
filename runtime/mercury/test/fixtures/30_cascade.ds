schema Trigger scope logical:
    id: Int key

schema Stage1 scope ttl 1_h:
    id: Int

schema Stage2 scope ttl 1_h:
    id: Int

rule opening:
    Trigger
->
    emit Stage1 id: 1

rule second:
    Stage1
->
    emit Stage2 id: 2

rule third:
    Stage2
->
    log info "cascade complete"
