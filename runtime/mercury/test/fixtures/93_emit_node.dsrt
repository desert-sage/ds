# The node list is unchecked by the compiler: `80_caps.dsrt`'s five, and an
# alpha, a beta and a terminal for `rule alarmed`.
contract:
  wm_max: 1024
  agenda_cap: 256
  max_fires_per_pump: 64
  token_pool_cap: 512
  intern_cap: 256
  intern_bytes_cap: 65536
  cache_cap: 64
  cache_bytes_cap: 16384
  pump_wcet_ns: 10000000

  nodes:
    - node_id:  1
      kind:     alpha
      capacity: 256
    - node_id:  2
      kind:     beta
      capacity: 256
    - node_id:  3
      kind:     alpha
      capacity: 256
    - node_id:  4
      kind:     beta
      capacity: 256
    - node_id:  5
      kind:     term
      capacity: 256
    - node_id:  6
      kind:     alpha
      capacity: 1
    - node_id:  7
      kind:     beta
      capacity: 256
    - node_id:  8
      kind:     term
      capacity: 256
