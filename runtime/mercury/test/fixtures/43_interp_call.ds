service light.turn_on:
    kwarg entity_id: String
    no response

schema Reading scope logical:
    id: Int key
    zone: String mutable
    level: Int mutable

rule call_it:
    Reading r
->
    call light.turn_on entity_id: "light.{r.zone}.{r.level:02d}" nocooldown as "corr-{r.id}"
