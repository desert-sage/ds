schema Smoke scope logical:
    id: Int key

schema Heat scope logical:
    id: Int key

schema Alarm scope logical:
    zone: String key

rule alarm_from_smoke:
    Smoke
->
    emit Alarm logical zone: "kitchen"

rule alarm_from_heat:
    Heat
->
    emit Alarm logical zone: "kitchen"
