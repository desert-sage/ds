# `80_caps.ds`'s network under `use default`, with a `sliding` series on
# `Reading.state`.

use default

schema Zone scope logical:
    name: String key
    threshold: Float mutable

schema Reading scope logical:
    entity_id: String key
    zone: String mutable
    state: Float mutable

schema Alarm scope ttl 1_h:
    entity_id: String
    detail: String

# On `Reading.state`, so the probe scripts, which assert `Zone` and `Reading`
# by name, drive it unchanged.
series Reading.state (by: entity_id):
    mean sliding 10_min

rule warm:
    Zone z
    Reading r where r.zone == z.name and r.state > 30.0
->
    log warning "warm {r.entity_id} in {z.name} mean={r.mean}"
    cache key: "last-warm" value: r.zone
    emit Alarm entity_id: r.entity_id detail: "over in {z.name}"
