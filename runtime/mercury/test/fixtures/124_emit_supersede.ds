schema Seed scope logical:
    n: Int key

schema Made scope logical:
    id: Int key
    n: Int mutable

rule make:
    Seed s
->
    emit Made logical id: 1 n: s.n

rule report:
    Made m
->
    log info "made n={m.n}"
