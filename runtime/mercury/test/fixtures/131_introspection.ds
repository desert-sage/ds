# The introspection reads ([NDBG.4.1]-[NDBG.4.3]). `high`'s `where` is a
# constant conjunct, which the compiler emits as an alpha test, so `Reading`
# dispatches to two alpha nodes, one filtering on `level > 50`. A match trace
# of a Reading shows one of each result for a low level, and both passing for
# a high one.
#
# `Noise` is in no rule's pattern: asserting it is the unrelated assert that
# must not empty the refraction listing ([IRET.11.3.2]).

schema Reading scope logical:
    id: Int key
    level: Int mutable

schema Noise scope logical:
    id: Int key

rule high:
    Reading r where r.level > 50
->
    log info "high {r.id}"

rule any:
    Reading r
->
    log info "any {r.id}"
