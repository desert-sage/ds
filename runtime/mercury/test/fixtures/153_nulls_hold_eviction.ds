# The value `nulls: hold` repeats outlives eviction ([LNUL.8.6], [LSER.9.3.2]).
# `mean sliding` is a ring buffer over a non-Bool slot and `last sliding` a FIFO
# deque, so a window of silence frees each row ([LSER.9.3.1]). Both rules read
# before the third fact's own sample, which a held value alone can answer.
# `118_nulls_hold_eviction` drives it through both engines.

use default

schema Reading scope logical:
    dev: String key
    level: Float? mutable
    label: String? mutable
    n: Int mutable

schema Other scope explicit:
    k: Int

series Reading.level (by: dev, nulls: hold):
    mean sliding 1_min

series Reading.label (by: dev, nulls: hold):
    last sliding 1_min

rule held_mean:
    Reading s where s.n == 3 and s.mean is not null
->
    log critical "mean {s.mean}"

rule held_last:
    Reading s where s.n == 3 and s.last is not null
->
    log critical "last {s.last}"
