use default
# A negative: `series_min` is not DS. The series line names an aggregation
# [LSER.17.2] does not list, and the call names no builtin, so
# `compile_corpus.py` expects DS_VALIDATE_SERIES_AGG_NOT_SUPPORTED.

schema Thermometer scope logical:
    entity_id: String key
    temperature: Float mutable

schema Report scope ttl 1_h:
    label: String
    lo: Float

series Thermometer.temperature (by: entity_id):
    series_min, series_max sliding 10_min

rule explicit_form:
    Thermometer t
->
    emit Report label: t.entity_id lo: series_min(t.temperature) ?? -1.0
