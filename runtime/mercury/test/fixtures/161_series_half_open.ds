# The sliding window's half-open edge as a recorded value. At read time t the
# window is (t - W, t] ([LSER.14.1], [LSIG.2.2.4]): a sample exactly W old is
# outside it. `count`, `sum` and `mean` over `by: none` land in `Win`'s
# payload, so the run records the window's contents, where 100_window_edge.ds
# shows only which rule fired.
#
# `-1.0` is `mean`'s cold read ([LSER.19.8]); `count` and `sum` read 0 and
# 0.0.
use default

schema W scope logical:
    k: String key
    v: Float mutable

schema Win scope ttl 1_h:
    label: String
    n: Int
    total: Float
    avg: Float

series W.v (by: none):
    count, sum, mean sliding 10_s

rule r:
    W w
->
    emit Win label: w.k n: count(w.v) total: w.sum avg: w.mean ?? -1.0
