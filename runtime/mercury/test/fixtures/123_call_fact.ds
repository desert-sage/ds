schema Reading scope logical:
    id: String key
    n: Int mutable
    x: Float mutable
    ok: Bool mutable

service svc.send:
    kwarg reading: Reading
    kwarg tag: String
    no response

rule send:
    Reading r
->
    call svc.send tag: r.id reading: r nocooldown
