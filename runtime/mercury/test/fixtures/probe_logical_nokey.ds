# A `scope logical` schema with no `key` slot: the whole schema is one
# identity ([LFAC.1.7]).

schema NoKey scope logical:
    entity_id: String mutable
    v: Int mutable

schema Out scope ttl 1_h:
    tag: String

rule touch:
    NoKey
->
    emit Out tag: "seen"
