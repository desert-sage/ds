# SPDX-License-Identifier: BSD-4-Clause OR AGPL-3.0-or-later
# A match test that does not answer `true` or `false`, on a positive and a
# negated node:
#
#   `null`   [LNUL.4.7]: `no (P where C)` is satisfied iff C is false for
#            every P; a `null` C blocks, like a `true` one. `all_cool` does
#            not fire while a Sensor reads null.
#   a trap   `s.a / s.b` with `b = 0` is DIVIDE_BY_ZERO [LERR.1.4.3]. The
#            positive `div_where` does not admit; the negated `no_div` keeps
#            the block (only a definite `false` unblocks). `a` and `b` are
#            Int because only an all-Int division traps [LEXP.7.15.1].
#
# Each fault is recorded after the assert event of the fact whose propagation
# raised it ([RFCS.6.7]).
use default

schema Tick scope logical:
    id: Int key

schema Sensor scope logical:
    entity_id: String key
    state: Float? mutable
    a: Int mutable
    b: Int mutable

rule all_cool:
    Tick
    no Sensor s where s.state > 85.0
->
    log info "all_cool fired"

rule no_div:
    Tick
    no Sensor s where s.a / s.b > 1.0
->
    log info "no_div fired"

rule div_where:
    Sensor s where s.a / s.b > 1.0
->
    log info "div_where fired"
