# Casting a null source yields null; the conversion is not attempted and
# nothing raises ([LCST.4.3.4]). `converted` is the control: a present source
# still converts.

use default


schema Reading scope logical:
    entity_id: String key
    f: Float? mutable

rule absent:
    Reading r where (r.f::String?) is null
->
    log info "null source cast to null"

rule converted:
    Reading r where (r.f::String?) == "2.5"
->
    log info "present source still converts"
