# One match fires once in a self-join. Six patterns on one schema share one
# alpha node ([IRET.6.6]), so a fact right-activates six joins of one chain;
# deepest first ([IRET.7.7]) builds each match once.
# `specs/conformance/runtime/IRET.7.7_self_join_twenty.json` pins libds at 19
# firings, and this pair holds Mercury to libds on the same 20 words.

schema Word scope logical:
    id: Int key
    c0: Int mutable
    c1: Int mutable
    c2: Int mutable

rule square:
    Word f0
    Word f1
    Word f2
    Word f3 where f3.c0 == f0.c0 and f3.c1 == f1.c0 and f3.c2 == f2.c0
    Word f4 where f4.c0 == f0.c1 and f4.c1 == f1.c1 and f4.c2 == f2.c1
    Word f5 where f5.c0 == f0.c2 and f5.c1 == f1.c2 and f5.c2 == f2.c2
->
    log info "square {f0.id} {f1.id} {f2.id} {f3.id} {f4.id} {f5.id}"
