# Two live facts in one series row: `Reading` is `ttl`, so two readings of
# one sensor are two facts in one `by: sensor` row. Each is absorbed once,
# however many pumps follow: two readings and two pumps count 2. The read
# exists because a declared series that nothing reads emits no backend atom.
use default

schema Reading scope ttl 1_h:
    sensor: String
    level: Float

schema Report scope ttl 1_h:
    n: Int

series Reading.level (by: sensor):
    count sliding 10_min

rule report:
    Reading r
->
    emit Report n: count(r.level)
