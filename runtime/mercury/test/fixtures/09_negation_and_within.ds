schema DoorOpen scope ttl 1_h:
    ts: Time
    zone: String

schema Motion scope ttl 1_h:
    ts: Time
    location: String

schema Override scope logical:
    zone: String key

rule break_in_alert:
    DoorOpen d within 5_min
    no Override o where o.zone == d.zone
->
    log critical "door open at {d.zone}"

rule no_motion_after_door:
    DoorOpen d
    then Motion m within 30_s where m.location == d.zone
->
    log info "motion confirmed at {d.zone}"
