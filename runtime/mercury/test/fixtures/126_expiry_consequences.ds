schema Gate scope ttl 1_h:
    g: Int

schema Held scope logical:
    id: Int key

schema P scope logical:
    entity_id: String key
    n: Int mutable

schema Q scope logical:
    entity_id: String key
    d: Int mutable

rule keep:
    Gate
->
    emit Held logical id: 1

rule ratio:
    P p
    no Gate
    Q q where (p.n // q.d) > 0
->
    log info "ratio"
