# A `+realtime` bundle whose `wm_max` its scenario breaches: the runtime halts
# with DS_ERR_CONTRACT_BREACH when usage would exceed a cap ([RTCT.7]).
# Realtime-only: its MANIFEST row is commented out.

use realtime

schema Reading scope logical:
    entity_id: String key
    state: Float mutable

rule warm:
    Reading r where r.state > 30.0
->
    log warning "warm {r.entity_id}"
