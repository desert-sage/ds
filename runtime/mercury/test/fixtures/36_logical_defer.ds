schema Trig scope logical:
    v: Int key

schema PlainOut scope ttl 1_h:
    v: Int

schema LogicalOut scope logical:
    v: Int key

rule plain_then_log:
    Trig
->
    emit PlainOut v: 1
    log info "after the plain emit"

rule logical_then_log:
    Trig
->
    emit LogicalOut logical v: 2
    log info "after the logical emit"
