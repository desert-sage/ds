# A cached String is [IDSP.13.4]'s String row: U+0008 and U+000C are
# `\u0008` and `\u000c`, not the `\b` and `\f` [LGRA.5.8.7a] gives a string
# inside a Json value.

schema S scope logical:
    id: Int key
    s: String mutable

rule keep:
    S x
->
    cache key: "s" value: x.s
