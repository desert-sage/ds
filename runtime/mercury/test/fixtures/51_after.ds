# An `after`-only rule. The grammar's RHS is
# `(action+ after_clause* | after_clause+)`, so a rule may have no immediate
# action and its terminal an empty action list.

schema Trig scope logical:
    v: Int key

rule after_only:
    Trig
->
    after 5_min:
        log critical "deferred"
