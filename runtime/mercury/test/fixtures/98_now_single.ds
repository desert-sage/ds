# A clock-dependent `where` on a single-pattern rule, which [LTIM.2.6.2]
# permits. It names no binding, so it lowers to the fire guard and joins the
# clock tick. The threshold is the instant five seconds after the epoch, built
# as a Time by `calendar.time` ([LTIM.14.1]); the mock clock starts at 0.

use default
import calendar

schema Ping scope logical:
    id: Int key

rule late:
    Ping where now() > calendar.time(1970, 1, 1, 0, 0, 5)
->
    log warning "late fired"
