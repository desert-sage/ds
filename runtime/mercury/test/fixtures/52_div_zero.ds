# Division by zero, a recoverable hard error ([LERR.1.4.7]): the rule cycle
# continues past the failing activation. The divisor comes from a slot, so
# the compiler cannot fold it.

schema Reading scope logical:
    id: Int key
    divisor: Int mutable

schema Result scope ttl 1_h:
    val: Float

rule divide:
    Reading r
->
    emit Result val: 100 / r.divisor
