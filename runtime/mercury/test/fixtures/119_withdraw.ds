# `withdraw` ([IRET.10.5]) of the explicit Job a Trig names, logged before and
# after so the trace shows the firing goes on past it. Job 2 has no Trig and
# stays. The recording carries FactWithdraw AUTHOR_WITHDRAWN (cause 6).

schema Trig scope logical:
    v: Int key

schema Job scope explicit:
    id: Int

rule done:
    Trig t
    Job j where j.id == t.v
->
    log info "withdrawing {j.id}"
    withdraw j
    log info "withdrew one"
