schema Reply scope ttl 30_s:
    corr: String
    v: Int

service svc.read:
    kwarg n: Int
    response Reply

schema Trig scope logical:
    k: Int key

rule r:
    Trig t
->
    call svc.read n: t.k nocooldown as "c1"

rule seen:
    Reply x
->
    log info "reply {x.v}"
