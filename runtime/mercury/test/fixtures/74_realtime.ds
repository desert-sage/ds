# A `+realtime` bundle, carrying a `RealtimeContract` atom whose hash is the
# second element of the RT binding ([RBND.1.4], [RTCT.6]). Realtime-only: its
# MANIFEST row is commented out.

use realtime

schema Reading scope logical:
    entity_id: String key
    state: Float mutable

rule warm:
    Reading r where r.state > 30.0
->
    log warning "warm {r.entity_id}"
