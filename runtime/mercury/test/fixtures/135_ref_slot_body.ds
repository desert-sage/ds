# A rule emits facts whose slots refer to another fact ([RFCS.6.3],
# [RFCS.6a.3], [RDSC.5.8.3]). A reference slot's field is the `uint64` handle
# under which the referenced `Owner`'s FactAssert, recorded first, named it
# ([LGRA.5.7a.2]). `Tag.alt` is nullable: `tag_both` fills it, so its field is
# written; `tag_one` leaves it null ([LGRA.13.11]), so its field is absent.

schema Owner scope logical:
    id: Int key

schema Tag scope ttl 1_h:
    n: Int
    owner: Owner
    alt: Owner?

rule tag_both:
    Owner o where o.id == 1
->
    emit Tag n: 1 owner: o alt: o

rule tag_one:
    Owner o where o.id == 2
->
    emit Tag n: 2 owner: o
