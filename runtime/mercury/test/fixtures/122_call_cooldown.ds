schema Dev scope logical:
    id: String key
    level: Int mutable

service svc.slow:
    kwarg id: String
    no response

service svc.fast:
    kwarg id: String
    no response

rule notify:
    Dev d
->
    call svc.slow id: d.id cooldown: 60_s
    call svc.fast id: d.id cooldown: 10_s
    log info "fired {d.id} {d.level}"
