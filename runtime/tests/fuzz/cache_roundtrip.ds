#
# cache_roundtrip.ds -- the program fuzz_cache_roundtrip.c loads. `copy`
# reads the cache key named in a Probe's `name` with `cached()` and writes it,
# as a String, under "out".

use default

schema Probe scope logical:
    name: String key

rule copy:
    Probe p
->
    let v = cached(p.name)
    cache key: "out" value: v
