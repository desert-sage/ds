# libFuzzer dictionary for fuzz_text_scalars: the tokens of DS's
# numeric literals and the values at the edges the readers decide on.
hex="0x"
bin="0b"
oct="0o"
sep="_"
dot="."
exp="e"
exp_upper="E"
exp_plus="e+"
exp_minus="e-"
minus="-"
plus="+"
inf="inf"
int64_max="9223372036854775807"
int64_over="9223372036854775808"
hex_int64_min="0x8000000000000000"
two53_plus1="9007199254740993"
float_max="1.7976931348623157e308"
float_min_sub="5e-324"
exp_big="99999999999"
